#!/usr/bin/env python3
"""spec-resolve — cross-repo reference resolver for haex-hive.

Subcommands: resolve, prefetch, status. See
`specs/004-cross-repo-refs/contracts/spec-resolve.cli.md` for the full
contract. Exit codes:

    0  success
    1  reference or scope refused by allowlist (Principle V)
    2  config invalid (schema violation, unknown role, forbidden field combo)
    3  resolution failed (missing SHA, git-fetch failure, path not present)
    4  invalid CLI usage
    5  unexpected internal error
"""

from __future__ import annotations

import argparse
import datetime
import glob
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Any


# ---------------------------------------------------------------------------
# Exit-code constants
# ---------------------------------------------------------------------------

EXIT_OK = 0
EXIT_REFUSED = 1
EXIT_CONFIG = 2
EXIT_RESOLVE = 3
EXIT_USAGE = 4
EXIT_INTERNAL = 5


# ---------------------------------------------------------------------------
# Custom exceptions
# ---------------------------------------------------------------------------


class SpecResolveError(Exception):
    """Base for typed errors mapped to specific exit codes."""

    exit_code: int = EXIT_INTERNAL


class ConfigError(SpecResolveError):
    exit_code = EXIT_CONFIG


class RefusedError(SpecResolveError):
    exit_code = EXIT_REFUSED


class ResolveError(SpecResolveError):
    exit_code = EXIT_RESOLVE


class UsageError(SpecResolveError):
    exit_code = EXIT_USAGE


# ---------------------------------------------------------------------------
# Validators (T012 + T028)
# ---------------------------------------------------------------------------

# Full 40-character commit SHA — matches the embedded schema's `revision`
# pattern so a value that passes spec-resolve cannot fail schema
# validation (and vice versa). Short prefixes can resolve locally but
# fail at `git fetch <sha>`; refuse them here too.
SHA_PATTERN = re.compile(r"^[0-9a-f]{40}$")

# URL schemes we accept. See research.md Decision 5.
URL_PATTERN = re.compile(r"^(https://|ssh://)")
SCP_PATTERN = re.compile(r"^[^/@:\s]+@[^/@:\s]+:.+$")
REJECT_PATTERNS = [
    (re.compile(r"^file://"), "file:// scheme not permitted"),
    (re.compile(r"^git://"), "git:// scheme not permitted (unencrypted)"),
    (re.compile(r"^http://"), "http:// scheme not permitted (unencrypted)"),
]

VALID_ROLES = frozenset({"constitution"})


def is_valid_repository(value: str) -> bool:
    """Return True iff `value` is 'self' or matches an accepted URL scheme."""
    if value == "self":
        return True
    if URL_PATTERN.match(value):
        return True
    if SCP_PATTERN.match(value):
        return True
    return False


def repository_reject_reason(value: str) -> str:
    """Explain why a repository value fails validation.

    Callers only invoke this after is_valid_repository returned False.
    """
    if not isinstance(value, str) or value == "":
        return "repository must be a non-empty string"
    for pattern, reason in REJECT_PATTERNS:
        if pattern.match(value):
            return reason
    return (
        "repository must be 'self' or a URL using https://, ssh://, or "
        "SCP-style user@host:path"
    )


def normalise_sha(value: str) -> str:
    """Case-normalise a SHA-hex string before pattern-checking (Decision 4)."""
    return value.lower()


def is_valid_sha(value: str) -> bool:
    return bool(SHA_PATTERN.match(normalise_sha(value)))


def cache_dir_hash(repository: str) -> str:
    """Derive the per-repo cache-dir name (Decision 2)."""
    return hashlib.sha256(repository.encode("utf-8")).hexdigest()[:16]


# ---------------------------------------------------------------------------
# Config loader (T011)
# ---------------------------------------------------------------------------


def find_haex_hive_json(repo_root: Path) -> Path:
    path = repo_root / ".haex-hive.json"
    if not path.is_file():
        raise ConfigError(
            f".haex-hive.json not found at {path}; is this a haex-hive repo?"
        )
    return path


def parse_haex_hive_json(path: Path) -> dict[str, Any]:
    try:
        raw = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise ConfigError(f"failed to read {path}: {exc}") from exc
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise ConfigError(f"{path}: invalid JSON ({exc.msg} at line {exc.lineno})") from exc
    if not isinstance(data, dict):
        raise ConfigError(f"{path}: top-level value must be an object")
    return data


def _entry_prefix(index: int) -> str:
    return f"harness_sources[{index}]"


def validate_config(data: dict[str, Any], source: str) -> None:
    """Targeted validation mirroring `.specify/schemas/haex-hive.schema.json`.

    Raises ConfigError with a message identifying the offending entry by
    array index + field + constraint per FR-017 / T028.
    """
    # Top-level required fields
    required_top = {"haex_hive_version", "identity", "harness_sources"}
    missing = required_top - set(data.keys())
    if missing:
        names = ", ".join(sorted(missing))
        raise ConfigError(f"{source}: missing required top-level field(s): {names}")

    if data["haex_hive_version"] != "1":
        raise ConfigError(
            f"{source}: haex_hive_version must be exactly '1' "
            f"(got {data['haex_hive_version']!r})"
        )

    if not isinstance(data["identity"], str) or not data["identity"]:
        raise ConfigError(f"{source}: identity must be a non-empty string")

    if "identity_note" in data and not isinstance(data["identity_note"], str):
        raise ConfigError(f"{source}: identity_note must be a string when present")

    if "groups" in data and not isinstance(data["groups"], list):
        raise ConfigError(f"{source}: groups must be an array when present")

    if "active_feature" in data:
        af = data["active_feature"]
        if af is not None and not isinstance(af, str):
            raise ConfigError(f"{source}: active_feature must be a string or null")

    # Reject any additionalProperties at top level
    allowed_top = required_top | {"identity_note", "groups", "active_feature"}
    extras = set(data.keys()) - allowed_top
    if extras:
        names = ", ".join(sorted(extras))
        raise ConfigError(
            f"{source}: unknown top-level field(s): {names} "
            f"(schema disallows additionalProperties)"
        )

    sources = data["harness_sources"]
    if not isinstance(sources, list):
        raise ConfigError(f"{source}: harness_sources must be an array")

    role_seen: dict[str, int] = {}
    for idx, entry in enumerate(sources):
        prefix = _entry_prefix(idx)
        if not isinstance(entry, dict):
            raise ConfigError(f"{source}: {prefix} must be an object")

        allowed_fields = {"role", "repository", "revision", "path", "paths"}
        unknown = set(entry.keys()) - allowed_fields
        if unknown:
            names = ", ".join(sorted(unknown))
            raise ConfigError(
                f"{source}: {prefix} has unknown field(s): {names} "
                f"(schema disallows additionalProperties)"
            )

        if "repository" not in entry:
            raise ConfigError(
                f"{source}: {prefix} missing required field 'repository'"
            )
        repository = entry["repository"]
        if not isinstance(repository, str):
            raise ConfigError(f"{source}: {prefix}.repository must be a string")
        if not is_valid_repository(repository):
            reason = repository_reject_reason(repository)
            raise ConfigError(f"{source}: {prefix}.repository invalid — {reason}")

        has_role = "role" in entry
        has_path = "path" in entry
        has_paths = "paths" in entry
        has_revision = "revision" in entry

        if has_role:
            role = entry["role"]
            if role not in VALID_ROLES:
                valid = ", ".join(sorted(VALID_ROLES))
                raise ConfigError(
                    f"{source}: {prefix}.role unknown value {role!r} "
                    f"(valid: {valid})"
                )
            if role in role_seen:
                other = role_seen[role]
                raise ConfigError(
                    f"{source}: role {role!r} used by both {_entry_prefix(other)} "
                    f"and {prefix}; each role may appear at most once"
                )
            role_seen[role] = idx

            if not has_revision:
                raise ConfigError(
                    f"{source}: {prefix} is role-carrying — required field "
                    f"'revision' missing"
                )
            if not has_path:
                raise ConfigError(
                    f"{source}: {prefix} is role-carrying — required field "
                    f"'path' missing"
                )
            if has_paths:
                raise ConfigError(
                    f"{source}: {prefix} has both 'path' and 'paths' — "
                    f"role-carrying entries use 'path' (singular) only"
                )
        else:
            # Permission-only entry rules
            if has_path:
                raise ConfigError(
                    f"{source}: {prefix} has 'path' without 'role' — "
                    f"permission-only entries use 'paths' (plural) or omit both"
                )
            if repository == "self":
                raise ConfigError(
                    f"{source}: {prefix}.repository is 'self' without a 'role' — "
                    f"'self' is reserved for role-carrying entries"
                )

        if has_revision:
            revision = entry["revision"]
            if not isinstance(revision, str):
                raise ConfigError(f"{source}: {prefix}.revision must be a string")
            # Reject mixed-case here (schema-mirror strictness) but the resolve
            # path normalises case elsewhere (Decision 4 defence in depth).
            if revision != revision.lower():
                raise ConfigError(
                    f"{source}: {prefix}.revision must be lowercase hex "
                    f"(got {revision!r})"
                )
            if not is_valid_sha(revision):
                raise ConfigError(
                    f"{source}: {prefix}.revision {revision!r} does not match "
                    f"SHA pattern ^[0-9a-f]{{40}}$ (full 40-char commit SHA)"
                )

        if has_path:
            path = entry["path"]
            if not isinstance(path, str) or not path:
                raise ConfigError(
                    f"{source}: {prefix}.path must be a non-empty string"
                )

        if has_paths:
            paths = entry["paths"]
            if not isinstance(paths, list) or not paths:
                raise ConfigError(
                    f"{source}: {prefix}.paths must be a non-empty array of strings"
                )
            for j, item in enumerate(paths):
                if not isinstance(item, str) or not item:
                    raise ConfigError(
                        f"{source}: {prefix}.paths[{j}] must be a non-empty string"
                    )


# ---------------------------------------------------------------------------
# Cache helpers
# ---------------------------------------------------------------------------


def cache_root() -> Path:
    xdg = os.environ.get("XDG_CACHE_HOME")
    base = Path(xdg) if xdg else Path.home() / ".cache"
    return base / "haex-hive" / "repos"


def cache_dir_for(repository: str) -> Path:
    return cache_root() / cache_dir_hash(repository)


def cache_meta_path(cache_dir: Path) -> Path:
    return cache_dir / ".haex-hive-cache-meta.json"


def read_cache_meta(cache_dir: Path) -> dict[str, Any] | None:
    meta = cache_meta_path(cache_dir)
    if not meta.is_file():
        return None
    try:
        return json.loads(meta.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def write_cache_meta(cache_dir: Path, repository: str) -> None:
    now = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    meta = read_cache_meta(cache_dir) or {}
    if not meta.get("repository"):
        meta["repository"] = repository
    if not meta.get("first_seen"):
        meta["first_seen"] = now
    meta["last_fetch"] = now
    cache_dir.mkdir(parents=True, exist_ok=True)
    cache_meta_path(cache_dir).write_text(
        json.dumps(meta, indent=2) + "\n", encoding="utf-8"
    )


# ---------------------------------------------------------------------------
# Git helpers
# ---------------------------------------------------------------------------


def run_git(args: list[str], cwd: Path | None = None, capture: bool = True) -> subprocess.CompletedProcess:
    cmd = ["git"]
    if cwd is not None:
        cmd += ["-C", str(cwd)]
    cmd += args
    return subprocess.run(
        cmd,
        check=False,
        capture_output=capture,
        text=False,
    )


def git_has_commit(repo_dir: Path, sha: str) -> bool:
    result = run_git(["cat-file", "-e", f"{sha}^{{commit}}"], cwd=repo_dir)
    return result.returncode == 0


def git_show(repo_dir: Path, sha: str, path: str) -> bytes:
    result = run_git(["show", f"{sha}:{path}"], cwd=repo_dir)
    if result.returncode != 0:
        stderr = (result.stderr or b"").decode("utf-8", errors="replace").strip()
        raise ResolveError(
            f"git show {sha}:{path} failed in {repo_dir}: {stderr or '(no stderr)'}"
        )
    return result.stdout


# ---------------------------------------------------------------------------
# Resolve — self branch (T016)
# ---------------------------------------------------------------------------


def resolve_self(repo_root: Path, sha: str, path: str) -> bytes:
    if not git_has_commit(repo_root, sha):
        raise ResolveError(
            f"pinned SHA {sha} not present in local repo at {repo_root}. "
            f"Fetch the missing commit or update the pin in .haex-hive.json."
        )
    return git_show(repo_root, sha, path)


# ---------------------------------------------------------------------------
# Resolve — external branch (T017)
# ---------------------------------------------------------------------------


def ensure_bare_cache_dir(cache_dir: Path) -> None:
    if cache_dir.is_dir() and (cache_dir / "HEAD").exists():
        return
    cache_dir.mkdir(parents=True, exist_ok=True)
    result = run_git(["init", "--bare", str(cache_dir)])
    if result.returncode != 0:
        stderr = (result.stderr or b"").decode("utf-8", errors="replace").strip()
        raise ResolveError(f"failed to init bare cache dir {cache_dir}: {stderr}")


def _try_fetch(cache_dir: Path, url: str, sha: str | None, extra: list[str]) -> bool:
    args = ["fetch"] + extra + [url]
    if sha is not None:
        args.append(sha)
    result = run_git(args, cwd=cache_dir)
    return result.returncode == 0


def fetch_external_sha(cache_dir: Path, url: str, sha: str) -> None:
    """Fetch ladder per research.md Decision 3."""
    # Ladder 1: shallow SHA-refspec fetch
    if _try_fetch(cache_dir, url, sha, ["--depth=1"]):
        return
    # Ladder 2: full-depth SHA-refspec fetch
    if _try_fetch(cache_dir, url, sha, []):
        return
    # Ladder 3: fetch default branch, hope the SHA is reachable
    if _try_fetch(cache_dir, url, None, []):
        if git_has_commit(cache_dir, sha):
            return
    # Ladder 4: full mirror fetch, last resort
    result = run_git(
        ["fetch", url, "+refs/*:refs/*"], cwd=cache_dir
    )
    if result.returncode != 0:
        stderr = (result.stderr or b"").decode("utf-8", errors="replace").strip()
        raise ResolveError(
            f"failed to fetch {sha} from {url} at any ladder tier: {stderr}"
        )
    if not git_has_commit(cache_dir, sha):
        raise ResolveError(
            f"SHA {sha} not reachable from {url} even after full mirror fetch"
        )


def resolve_external(repository: str, sha: str, path: str, offline: bool = False) -> bytes:
    cache_dir = cache_dir_for(repository)
    ensure_bare_cache_dir(cache_dir)
    if not git_has_commit(cache_dir, sha):
        if offline:
            raise ResolveError(
                f"pinned SHA {sha} not present in cache for {repository} "
                f"and offline-safe mode requested"
            )
        fetch_external_sha(cache_dir, repository, sha)
        write_cache_meta(cache_dir, repository)
    return git_show(cache_dir, sha, path)


# ---------------------------------------------------------------------------
# Allowlist matching (T024)
# ---------------------------------------------------------------------------


def find_role_entry(config: dict[str, Any], role: str) -> dict[str, Any]:
    sources = config.get("harness_sources", [])
    matches = [e for e in sources if e.get("role") == role]
    if not matches:
        raise ConfigError(
            f"no harness_sources entry with role={role!r} found in .haex-hive.json"
        )
    if len(matches) > 1:
        raise ConfigError(
            f"role={role!r} used by multiple harness_sources entries; "
            f"each role may appear at most once"
        )
    return matches[0]


def entry_permits(
    entry: dict[str, Any], repository: str, sha: str, path: str
) -> bool:
    """Return True iff `entry` permits the (repository, sha, path) triple.

    Applies the four shape rules from data-model.md.
    """
    entry_repo = entry.get("repository")
    if entry_repo != repository:
        return False

    has_role = "role" in entry
    if has_role:
        # Role-carrying entries permit only their own exact triple.
        return (
            entry.get("revision") == sha
            and entry.get("path") == path
        )

    # Permission-only entry.
    entry_revision = entry.get("revision")
    if entry_revision is not None and entry_revision != sha:
        return False

    entry_paths = entry.get("paths")
    if entry_paths is not None:
        if path not in entry_paths:
            return False
    return True


def find_permitting_entry(
    config: dict[str, Any], repository: str, sha: str, path: str
) -> dict[str, Any] | None:
    for entry in config.get("harness_sources", []):
        if entry_permits(entry, repository, sha, path):
            return entry
    return None


# ---------------------------------------------------------------------------
# Reference enumeration (for prefetch/status)
# ---------------------------------------------------------------------------


def enumerate_role_refs(config: dict[str, Any]) -> list[dict[str, str]]:
    refs = []
    for entry in config.get("harness_sources", []):
        if "role" in entry:
            refs.append(
                {
                    "repository": entry["repository"],
                    "revision": entry["revision"],
                    "path": entry["path"],
                }
            )
    return refs


def enumerate_spec_ref_json_refs(repo_root: Path) -> list[dict[str, str]]:
    refs: list[dict[str, str]] = []
    pattern = str(repo_root / "specs" / "*" / "spec-ref.json")
    for path_str in sorted(glob.glob(pattern)):
        try:
            data = json.loads(Path(path_str).read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(data, dict):
            continue
        for _, value in data.items():
            if not isinstance(value, dict):
                continue
            repo = value.get("repository")
            rev = value.get("revision")
            p = value.get("path")
            if isinstance(repo, str) and isinstance(rev, str) and isinstance(p, str):
                refs.append({"repository": repo, "revision": rev, "path": p})
    return refs


def dedup_refs(refs: list[dict[str, str]]) -> list[dict[str, str]]:
    seen: set[tuple[str, str, str]] = set()
    result: list[dict[str, str]] = []
    for r in refs:
        key = (r["repository"], r["revision"], r["path"])
        if key in seen:
            continue
        seen.add(key)
        result.append(r)
    return result


# ---------------------------------------------------------------------------
# Cache-presence check (for status)
# ---------------------------------------------------------------------------


def ref_is_cached(repo_root: Path, ref: dict[str, str]) -> bool:
    if ref["repository"] == "self":
        return git_has_commit(repo_root, ref["revision"])
    cache_dir = cache_dir_for(ref["repository"])
    if not (cache_dir / "HEAD").exists():
        return False
    return git_has_commit(cache_dir, ref["revision"])


# ---------------------------------------------------------------------------
# Subcommand: resolve (T014 + T015 + T025)
# ---------------------------------------------------------------------------


def _write_stdout_bytes(data: bytes) -> None:
    try:
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()
    except BrokenPipeError:
        # Piped consumers may close early; exit cleanly.
        pass


def cmd_resolve(args: argparse.Namespace, repo_root: Path, config: dict[str, Any]) -> int:
    has_role = args.role is not None
    has_triple = any(v is not None for v in (args.repository, args.revision, args.path))
    if has_role and has_triple:
        raise UsageError(
            "provide either --role OR --repository/--revision/--path, not both"
        )
    if not has_role and not has_triple:
        raise UsageError(
            "resolve requires either --role or --repository/--revision/--path"
        )
    if has_triple and not all(
        v is not None for v in (args.repository, args.revision, args.path)
    ):
        raise UsageError(
            "direct-triple mode requires all three of --repository, --revision, --path"
        )

    if has_role:
        entry = find_role_entry(config, args.role)
        repository = entry["repository"]
        sha = normalise_sha(entry["revision"])
        path = entry["path"]
        # Role-carrying entries are self-permitting; no allowlist match needed.
    else:
        repository = args.repository
        sha = normalise_sha(args.revision)
        path = args.path
        if not is_valid_repository(repository):
            reason = repository_reject_reason(repository)
            raise UsageError(f"--repository {repository!r} invalid — {reason}")
        if not is_valid_sha(sha):
            raise UsageError(
                f"--revision {args.revision!r} does not match SHA pattern ^[0-9a-f]{{7,40}}$"
            )
        # Allowlist enforcement (T025).
        if find_permitting_entry(config, repository, sha, path) is None:
            raise RefusedError(
                f"refusing reference {repository}@{sha}:{path} — "
                f"not permitted by any entry in harness_sources."
            )

    if repository == "self":
        data = resolve_self(repo_root, sha, path)
    else:
        data = resolve_external(repository, sha, path)

    _write_stdout_bytes(data)
    return EXIT_OK


# ---------------------------------------------------------------------------
# Subcommand: prefetch (T018)
# ---------------------------------------------------------------------------


def cmd_prefetch(args: argparse.Namespace, repo_root: Path, config: dict[str, Any]) -> int:
    role_refs = enumerate_role_refs(config)
    spec_refs = enumerate_spec_ref_json_refs(repo_root)
    refs = dedup_refs(role_refs + spec_refs)

    if args.dry_run:
        anything_missing = False
        for ref in refs:
            status = "OK" if ref_is_cached(repo_root, ref) else "MISSING"
            if status == "MISSING":
                anything_missing = True
            print(f"{status} {ref['repository']}@{ref['revision']}:{ref['path']}")
        return EXIT_OK

    failed: list[str] = []
    for ref in refs:
        if ref_is_cached(repo_root, ref):
            continue
        try:
            if ref["repository"] == "self":
                if not git_has_commit(repo_root, ref["revision"]):
                    failed.append(
                        f"{ref['repository']}@{ref['revision']} (self ref missing locally)"
                    )
                continue
            cache_dir = cache_dir_for(ref["repository"])
            ensure_bare_cache_dir(cache_dir)
            fetch_external_sha(cache_dir, ref["repository"], ref["revision"])
            write_cache_meta(cache_dir, ref["repository"])
        except ResolveError as exc:
            failed.append(f"{ref['repository']}@{ref['revision']} ({exc})")

    if failed:
        print(
            "spec-resolve prefetch: unresolved references:",
            file=sys.stderr,
        )
        for f in failed:
            print(f"  - {f}", file=sys.stderr)
        return EXIT_RESOLVE
    return EXIT_OK


# ---------------------------------------------------------------------------
# Subcommand: status (T019)
# ---------------------------------------------------------------------------


def _latest_last_fetch(refs: list[dict[str, str]]) -> str | None:
    latest: str | None = None
    for ref in refs:
        if ref["repository"] == "self":
            continue
        meta = read_cache_meta(cache_dir_for(ref["repository"]))
        if not meta:
            continue
        lf = meta.get("last_fetch")
        if isinstance(lf, str) and (latest is None or lf > latest):
            latest = lf
    return latest


def _days_ago(iso: str) -> int:
    try:
        stripped = iso.rstrip("Z")
        # datetime.fromisoformat handles offsets but not trailing Z.
        dt = datetime.datetime.fromisoformat(stripped)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=datetime.timezone.utc)
    except ValueError:
        return 0
    now = datetime.datetime.now(datetime.timezone.utc)
    return max(0, (now - dt).days)


def cmd_status(args: argparse.Namespace, repo_root: Path, config: dict[str, Any]) -> int:
    role_refs = enumerate_role_refs(config)
    spec_refs = enumerate_spec_ref_json_refs(repo_root)
    refs = dedup_refs(role_refs + spec_refs)

    cached_flags = [ref_is_cached(repo_root, r) for r in refs]
    total = len(refs)
    cached = sum(1 for c in cached_flags if c)
    missing = total - cached
    latest = _latest_last_fetch(refs)

    if args.json:
        payload = {
            "refs_total": total,
            "refs_cached": cached,
            "refs_missing": missing,
            "last_update_check": (
                {
                    "iso": latest,
                    "days_ago": _days_ago(latest),
                }
                if latest
                else None
            ),
            "sources": [
                {
                    "repository": r["repository"],
                    "revision": r["revision"],
                    "path": r["path"],
                    "cached": cached_flags[i],
                    "last_fetch": (
                        None
                        if r["repository"] == "self"
                        else (read_cache_meta(cache_dir_for(r["repository"])) or {}).get(
                            "last_fetch"
                        )
                    ),
                }
                for i, r in enumerate(refs)
            ],
        }
        print(json.dumps(payload, indent=2))
        return EXIT_OK

    # Text mode.
    ref_word = "ref" if total == 1 else "refs"
    if latest is None:
        summary_when = "last update-check: never"
    else:
        # ISO like 2026-08-27T12:00:00Z → show just the date.
        date_part = latest.split("T", 1)[0]
        summary_when = f"last update-check: {date_part} ({_days_ago(latest)} days ago)"
    if missing:
        summary_count = f"{total} {ref_word}, {cached} cached ({missing} missing)"
    else:
        summary_count = f"{total} {ref_word}, {cached} cached"
    print(f"{summary_count}, {summary_when}")
    return EXIT_OK


# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="spec-resolve",
        description=(
            "Cross-repo reference resolver for haex-hive. "
            "See docs/spec-resolve.md for the full command surface."
        ),
    )
    parser.add_argument(
        "--repo",
        type=Path,
        default=None,
        help="Override the enclosing repo (default: current working directory).",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    resolve = sub.add_parser("resolve", help="Resolve one reference to stdout.")
    resolve.add_argument("--role", type=str, default=None)
    resolve.add_argument("--repository", type=str, default=None)
    resolve.add_argument("--revision", type=str, default=None)
    resolve.add_argument("--path", type=str, default=None)

    prefetch = sub.add_parser(
        "prefetch",
        help="Populate cache for every discoverable reference.",
    )
    prefetch.add_argument("--dry-run", action="store_true")

    status = sub.add_parser(
        "status",
        help="Report cache presence and last-update-check for known references.",
    )
    status.add_argument("--json", action="store_true")

    # Deferred subcommands — surface a friendly refusal per contract.
    sub.add_parser(
        "check-updates",
        help="[deferred] fetch and diff against pinned SHAs — see Spec 005.",
    )
    sub.add_parser(
        "bump",
        help="[deferred] write proposed SHA-update commits — see Spec 005.",
    )
    return parser


def resolve_repo_root(cli_repo: Path | None) -> Path:
    if cli_repo is not None:
        return cli_repo.resolve()
    return Path.cwd().resolve()


# ---------------------------------------------------------------------------
# Entrypoint
# ---------------------------------------------------------------------------


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.cmd in {"check-updates", "bump"}:
        print(
            f"spec-resolve: subcommand {args.cmd!r} is deferred to Spec 005.",
            file=sys.stderr,
        )
        return EXIT_USAGE

    try:
        repo_root = resolve_repo_root(args.repo)
        config_path = find_haex_hive_json(repo_root)
        config = parse_haex_hive_json(config_path)
        validate_config(config, str(config_path))

        if args.cmd == "resolve":
            return cmd_resolve(args, repo_root, config)
        if args.cmd == "prefetch":
            return cmd_prefetch(args, repo_root, config)
        if args.cmd == "status":
            return cmd_status(args, repo_root, config)
        # argparse guards against unknown subcommands, but be defensive.
        parser.print_usage(file=sys.stderr)
        return EXIT_USAGE
    except SpecResolveError as exc:
        print(f"spec-resolve: {exc}", file=sys.stderr)
        return exc.exit_code
    except KeyboardInterrupt:
        print("spec-resolve: interrupted", file=sys.stderr)
        return EXIT_INTERNAL


if __name__ == "__main__":
    sys.exit(main())
