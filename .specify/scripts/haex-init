# ---------------------------------------------------------------------------
# Regex constants
# ---------------------------------------------------------------------------

MARKER_BEGIN_RE = re.compile(r"^<!--\s*haex-hive-block:begin\s+v=([^\s>]+)\s*-->$")
MARKER_END_RE = re.compile(r"^<!--\s*haex-hive-block:end\s*-->$")

# External-ref URL scheme allowlist (matches spec-resolve's set).
URL_SCHEME_RE = re.compile(r"^(https://|ssh://|[^/@:\s]+@[^/@:\s]+:).+")
SHA_RE = re.compile(r"^[0-9a-f]{7,40}$")

# Non-empty hex; used for HEAD SHA validation.
FULL_SHA_RE = re.compile(r"^[0-9a-f]{40}$")


# ---------------------------------------------------------------------------
# Marker-block state (T008)
# ---------------------------------------------------------------------------


class MarkerPresence(str, Enum):
    ABSENT = "ABSENT"
    PRESENT_MATCHING_VERSION = "PRESENT_MATCHING_VERSION"
    PRESENT_MISMATCHED_VERSION = "PRESENT_MISMATCHED_VERSION"
    MALFORMED = "MALFORMED"


@dataclass
class MarkerBlockState:
    target_file: Path
    presence: MarkerPresence
    existing_version: str | None = None
    existing_line_range: tuple[int, int] | None = None
    existing_byte_range: tuple[int, int] | None = None
    existing_body_sha256: str | None = None
    malformed_reason: str | None = None


def detect_marker_block(target_file: Path) -> MarkerBlockState:
    """Return the marker-block state for target_file.

    Follows contracts/marker-block.format.md: a single-pass line scan
    producing one of ABSENT / PRESENT_MATCHING_VERSION /
    PRESENT_MISMATCHED_VERSION / MALFORMED, plus captured version,
    inclusive 1-indexed line range, and SHA-256 of the block's byte
    range.
    """
    if not target_file.exists():
        return MarkerBlockState(target_file=target_file, presence=MarkerPresence.ABSENT)
    try:
        raw = target_file.read_bytes()
        text = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        return MarkerBlockState(
            target_file=target_file,
            presence=MarkerPresence.MALFORMED,
            malformed_reason=(
                f"cannot parse {target_file}: invalid UTF-8 at byte {exc.start}"
            ),
        )

    # Keep physical line endings so CRLF files are recognised correctly and
    # replacement can preserve every byte outside the managed block.
    lines = text.splitlines(keepends=True)
    begins: list[tuple[int, str]] = []
    ends: list[int] = []
    byte_offsets: list[int] = []
    offset = 0
    for i, line in enumerate(lines, start=1):
        byte_offsets.append(offset)
        offset += len(line.encode("utf-8"))
        # Regexes describe marker content, not its transport line ending.
        line = line.rstrip("\r\n")
        mb = MARKER_BEGIN_RE.match(line)
        if mb:
            begins.append((i, mb.group(1)))
            continue
        if MARKER_END_RE.match(line):
            ends.append(i)

    if not begins and not ends:
        return MarkerBlockState(target_file=target_file, presence=MarkerPresence.ABSENT)

    if len(begins) > 1:
        first, second = begins[0][0], begins[1][0]
        return MarkerBlockState(
            target_file=target_file,
            presence=MarkerPresence.MALFORMED,
            malformed_reason=(
                f"multiple begin markers in {target_file} (lines {first} and "
                f"{second}); haex-init manages only one block"
            ),
        )
    if len(ends) > 1:
        first, second = ends[0], ends[1]
        return MarkerBlockState(
            target_file=target_file,
            presence=MarkerPresence.MALFORMED,
            malformed_reason=(
                f"multiple end markers in {target_file} (lines {first} and "
                f"{second}); haex-init manages only one block"
            ),
        )
    if begins and not ends:
        return MarkerBlockState(
            target_file=target_file,
            presence=MarkerPresence.MALFORMED,
            malformed_reason=(
                f"begin marker at line {begins[0][0]} has no matching end "
                f"marker in {target_file}"
            ),
        )
    if ends and not begins:
        return MarkerBlockState(
            target_file=target_file,
            presence=MarkerPresence.MALFORMED,
            malformed_reason=(
                f"end marker at line {ends[0]} has no matching begin marker "
                f"in {target_file}"
            ),
        )
    b_line, version = begins[0]
    e_line = ends[0]
    if b_line >= e_line:
        return MarkerBlockState(
            target_file=target_file,
            presence=MarkerPresence.MALFORMED,
            malformed_reason=(
                f"begin marker at line {b_line} appears at or after end "
                f"marker at line {e_line} in {target_file}"
            ),
        )
    block_start = byte_offsets[b_line - 1]
    block_end = byte_offsets[e_line - 1] + len(lines[e_line - 1].encode("utf-8"))
    block_bytes = raw[block_start:block_end]
    body_sha = hashlib.sha256(block_bytes).hexdigest()
    presence = (
        MarkerPresence.PRESENT_MATCHING_VERSION
        if version == INSTRUCTIONS_VERSION
        else MarkerPresence.PRESENT_MISMATCHED_VERSION
    )
    return MarkerBlockState(
        target_file=target_file,
        presence=presence,
        existing_version=version,
        existing_line_range=(b_line, e_line),
        existing_byte_range=(block_start, block_end),
        existing_body_sha256=body_sha,
    )


# ---------------------------------------------------------------------------
# Marker-block content helpers
# ---------------------------------------------------------------------------


def canonical_block_text(version: str = INSTRUCTIONS_VERSION) -> str:
    """Return the canonical marker-block content with the given version.

    Matches contracts/marker-block.format.md exactly: begin marker,
    H2 + blank + one-paragraph body, end marker, each terminated by a
    single trailing LF.
    """
    return (
        f"<!-- haex-hive-block:begin v={version} -->\n"
        "## haex-hive\n"
        "\n"
        "At session start, and in any repository containing `.haex-hive.json`\n"
        "at its root, read `~/.haex-hive/haex-hive.md` and follow the\n"
        "instructions there.\n"
        "<!-- haex-hive-block:end -->\n"
    )


def compose_appended_block(old_bytes: bytes) -> bytes:
    """Return old_bytes with the canonical block appended.

    Adds one leading LF if the file does not already end with a blank
    line (per contracts/marker-block.format.md).
    """
    block = canonical_block_text().encode("utf-8")
    if len(old_bytes) == 0:
        return block
    # A file "ends with a blank line" when the last character is LF
    # AND the second-to-last is also LF (i.e. there is an empty line
    # at the end). We separate the appended block from prior content
    # by one blank line — synthesise the leading LF as needed.
    if old_bytes.endswith(b"\n\n"):
        return old_bytes + block
    if old_bytes.endswith(b"\n"):
        return old_bytes + b"\n" + block
    return old_bytes + b"\n\n" + block


def compose_replaced_block(old_bytes: bytes, state: MarkerBlockState) -> bytes:
    """Return old_bytes with the byte-range of state replaced by the canonical block.

    Preserves every byte strictly outside the marker block's inclusive
    line range (byte-safety per SC-002).
    """
    assert state.existing_byte_range is not None, "REPLACE requires a present block"
    start, end = state.existing_byte_range
    return old_bytes[:start] + canonical_block_text().encode("utf-8") + old_bytes[end:]


# ---------------------------------------------------------------------------
# Detection matrix + DetectedTool (T009)
# ---------------------------------------------------------------------------

LLM_NAMES = {"claude-code", "codex", "gemini"}
IDE_NAMES = {"vscode", "vscode-insiders", "cursor", "windsurf", "jetbrains"}
ALL_TOOL_NAMES = LLM_NAMES | IDE_NAMES


@dataclass
class DetectionSpec:
    name: str
    category: str
    family: str
    executables: tuple[str, ...]
    config_dir_names: tuple[str, ...]
    user_global_config_file: str | None

    def config_dir_candidates(self, home: Path) -> list[Path]:
        return [home / rel for rel in self.config_dir_names]


DETECTION_MATRIX: dict[str, DetectionSpec] = {
    "claude-code": DetectionSpec(
        name="claude-code",
        category="llm",
        family="standalone",
        executables=("claude",),
        config_dir_names=(".claude",),
        user_global_config_file=".claude/CLAUDE.md",
    ),
    "codex": DetectionSpec(
        name="codex",
        category="llm",
        family="standalone",
        executables=("codex",),
        config_dir_names=(".codex",),
        user_global_config_file=".codex/AGENTS.md",
    ),
    "gemini": DetectionSpec(
        name="gemini",
        category="llm",
        family="standalone",
        executables=("gemini",),
        config_dir_names=(".gemini",),
        user_global_config_file=".gemini/GEMINI.md",
    ),
    "vscode": DetectionSpec(
        name="vscode",
        category="ide",
        family="vscode-family",
        executables=("code",),
        config_dir_names=(".config/Code",),
        user_global_config_file=None,
    ),
    "vscode-insiders": DetectionSpec(
        name="vscode-insiders",
        category="ide",
        family="vscode-family",
        executables=("code-insiders",),
        config_dir_names=(".config/Code - Insiders",),
        user_global_config_file=None,
    ),
    "cursor": DetectionSpec(
        name="cursor",
        category="ide",
        family="vscode-family",
        executables=("cursor",),
        config_dir_names=(".config/Cursor",),
        user_global_config_file=None,
    ),
    "windsurf": DetectionSpec(
        name="windsurf",
        category="ide",
        family="vscode-family",
        executables=("windsurf",),
        config_dir_names=(".config/Windsurf",),
        user_global_config_file=None,
    ),
    "jetbrains": DetectionSpec(
        name="jetbrains",
        category="ide",
        family="jetbrains-family",
        executables=(
            "idea",
            "pycharm",
            "goland",
            "webstorm",
            "phpstorm",
            "rubymine",
            "clion",
            "datagrip",
            "rider",
            "studio",
        ),
        config_dir_names=(".config/JetBrains",),
        user_global_config_file=None,
    ),
}


@dataclass
class DetectedTool:
    name: str
    category: str  # "llm" or "ide"
    family: str
    executable_path: Path | None
    config_dir: Path | None
    user_global_config_file: Path | None
    force_included: bool = False


def detect_tools(home: Path, include: set[str]) -> list[DetectedTool]:
    """Run the two-signal detection over the DETECTION_MATRIX.

    A tool is detected when at least one of its `executables` is on
    PATH AND at least one of its `config_dir_candidates` is a directory.
    Tools named in `include` are force-included regardless of the
    two-signal check.
    """
    detected: list[DetectedTool] = []
    for spec in DETECTION_MATRIX.values():
        force = spec.name in include
        exe_path: Path | None = None
        for exe in spec.executables:
            found = shutil.which(exe)
            if found:
                exe_path = Path(found)
                break
        config_dir: Path | None = None
        for candidate in spec.config_dir_candidates(home):
            if candidate.is_dir():
                config_dir = candidate
                break
        if not force and (exe_path is None or config_dir is None):
            continue
        # For force-included tools without a real config dir, synthesize the
        # first candidate path (T009: the marker block goes into a newly-
        # created config_dir/<config_file>).
        if config_dir is None:
            config_dir = spec.config_dir_candidates(home)[0]
        ugcf: Path | None = None
        if spec.user_global_config_file:
            ugcf = home / spec.user_global_config_file
        detected.append(
            DetectedTool(
                name=spec.name,
                category=spec.category,
                family=spec.family,
                executable_path=exe_path,
                config_dir=config_dir,
                user_global_config_file=ugcf,
                force_included=force,
            )
        )
    return detected


# ---------------------------------------------------------------------------
# Diff preview + atomic write helpers (T010)
# ---------------------------------------------------------------------------


def render_unified_diff(old_bytes: bytes, new_bytes: bytes, label: str) -> str:
    """Return a stdlib unified-diff string comparing old_bytes to new_bytes."""
    old_lines = old_bytes.decode("utf-8", errors="replace").splitlines(keepends=True)
    new_lines = new_bytes.decode("utf-8", errors="replace").splitlines(keepends=True)
    diff = difflib.unified_diff(
        old_lines,
        new_lines,
        fromfile=f"{label} (current)",
        tofile=f"{label} (proposed)",
        n=3,
    )
    return "".join(diff)


def atomic_write(target: Path, content: bytes) -> None:
    """Write content to target via os.replace(tempfile, target).

    Ensures the file is never left half-written on any exception in the
    write path. Follows contracts/marker-block.format.md's atomic-write
    protocol.
    """
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = target.parent / f"{target.name}.tmp-haex-init-{os.getpid()}"
    try:
        with open(tmp_path, "wb") as fp:
            fp.write(content)
            fp.flush()
            os.fsync(fp.fileno())
        os.replace(tmp_path, target)
    except Exception:
        try:
            tmp_path.unlink()
        except FileNotFoundError:
            pass
        raise


# ---------------------------------------------------------------------------
# Schema validator (T007) — targeted mirror of the embedded schema
# ---------------------------------------------------------------------------


def validate_haex_hive_config(cfg: object) -> list[str]:
    """Validate cfg against the embedded haex-hive schema.

    Returns a list of human-readable error messages; empty list means
    valid. This is a targeted mirror of the Draft-07 schema, sufficient
    for the shapes haex-init writes.
    """
    errors: list[str] = []
    if not isinstance(cfg, dict):
        return [f"root: expected object, got {type(cfg).__name__}"]

    allowed = {
        "haex_hive_version",
        "identity",
        "identity_note",
        "harness_sources",
        "groups",
        "active_feature",
        "managed_tools",
    }
    for k in cfg.keys():
        if k not in allowed:
            errors.append(f"root: unknown property {k!r}")

    for req in ("haex_hive_version", "identity", "harness_sources"):
        if req not in cfg:
            errors.append(f"root: missing required property {req!r}")

    if "haex_hive_version" in cfg and cfg["haex_hive_version"] != "1":
        errors.append(
            f"haex_hive_version: expected '1', got {cfg['haex_hive_version']!r}"
        )

    if "identity" in cfg:
        v = cfg["identity"]
        if not isinstance(v, str) or len(v) == 0:
            errors.append("identity: expected non-empty string")

    if "identity_note" in cfg and not isinstance(cfg["identity_note"], str):
        errors.append("identity_note: expected string")

    if "groups" in cfg and not isinstance(cfg["groups"], list):
        errors.append("groups: expected array")

    if "active_feature" in cfg:
        v = cfg["active_feature"]
        if v is not None and not isinstance(v, str):
            errors.append("active_feature: expected string or null")

    if "managed_tools" in cfg:
        v = cfg["managed_tools"]
        if not isinstance(v, list):
            errors.append("managed_tools: expected array")
        else:
            seen: set[str] = set()
            for i, item in enumerate(v):
                if not isinstance(item, str):
                    errors.append(f"managed_tools[{i}]: expected string")
                    continue
                if item not in ALL_TOOL_NAMES:
                    errors.append(
                        f"managed_tools[{i}]: {item!r} is not a known tool name "
                        f"(valid: {', '.join(sorted(ALL_TOOL_NAMES))})"
                    )
                if item in seen:
                    errors.append(
                        f"managed_tools[{i}]: duplicate entry {item!r}"
                    )
                seen.add(item)

    if "harness_sources" in cfg:
        hs = cfg["harness_sources"]
        if not isinstance(hs, list):
            errors.append("harness_sources: expected array")
        else:
            for i, entry in enumerate(hs):
                errors.extend(_validate_harness_source_entry(entry, i))
    return errors


def _validate_harness_source_entry(entry: object, index: int) -> list[str]:
    errors: list[str] = []
    prefix = f"harness_sources[{index}]"
    if not isinstance(entry, dict):
        return [f"{prefix}: expected object"]
    allowed = {"role", "repository", "revision", "path", "paths"}
    for k in entry.keys():
        if k not in allowed:
            errors.append(f"{prefix}: unknown property {k!r}")
    if "repository" not in entry:
        errors.append(f"{prefix}: missing required property 'repository'")
        return errors
    repo = entry["repository"]
    if not isinstance(repo, str):
        errors.append(f"{prefix}.repository: expected string")
    else:
        if repo != "self" and not URL_SCHEME_RE.match(repo):
            errors.append(
                f"{prefix}.repository: must be 'self' or a URL with accepted "
                "scheme (https://, ssh://, or SCP-style user@host:path)"
            )
    if "role" in entry:
        if entry["role"] != "constitution":
            errors.append(
                f"{prefix}.role: only 'constitution' is supported in Phase 1"
            )
        for req in ("revision", "path"):
            if req not in entry:
                errors.append(
                    f"{prefix}: role-carrying entry requires '{req}'"
                )
        if "paths" in entry:
            errors.append(
                f"{prefix}: role-carrying entry must not include 'paths'"
            )
        if "revision" in entry:
            rv = entry["revision"]
            if not isinstance(rv, str) or not SHA_RE.match(rv):
                errors.append(
                    f"{prefix}.revision: expected 7-40 lowercase hex chars"
                )
        if "path" in entry:
            p = entry["path"]
            if not isinstance(p, str) or len(p) == 0:
                errors.append(f"{prefix}.path: expected non-empty string")
    else:
        # Permission-only entry.
        if "path" in entry:
            errors.append(
                f"{prefix}: permission-only entry must not include 'path'"
            )
        if isinstance(repo, str) and repo == "self":
            errors.append(
                f"{prefix}: permission-only entry must not have repository "
                "'self'"
            )
        if "paths" in entry:
            paths = entry["paths"]
            if not isinstance(paths, list) or len(paths) == 0:
                errors.append(
                    f"{prefix}.paths: expected non-empty array of strings"
                )
            else:
                for j, item in enumerate(paths):
                    if not isinstance(item, str) or len(item) == 0:
                        errors.append(
                            f"{prefix}.paths[{j}]: expected non-empty string"
                        )
        if "revision" in entry:
            rv = entry["revision"]
            if not isinstance(rv, str) or not SHA_RE.match(rv):
                errors.append(
                    f"{prefix}.revision: expected 7-40 lowercase hex chars"
                )
    return errors


# ---------------------------------------------------------------------------
# ProjectState + UserGlobalState snapshotters (T011, T012)
# ---------------------------------------------------------------------------


@dataclass
class ProjectState:
    project_dir: Path
    is_git_repo: bool = False
    has_haex_hive_json: bool = False
    haex_hive_json_valid: bool | None = None
    haex_hive_json_content: dict | None = None
    has_canonical_schema_file: bool = False
    canonical_schema_matches_embedded: bool | None = None
    has_constitution_file: bool = False
    has_vscode_settings: bool = False
    vscode_settings_wired: bool | None = None
    has_idea_json_schemas: bool = False
    idea_json_schemas_wired: bool | None = None
    idea_is_gitignored: bool = False
    gitignore_missing_patterns: list[str] = field(default_factory=list)


GITIGNORE_REQUIRED_PATTERNS: tuple[str, ...] = ("__pycache__/",)


def snapshot_project(project_dir: Path) -> ProjectState:
    state = ProjectState(project_dir=project_dir)
    state.is_git_repo = _run_git_check(project_dir, ["rev-parse", "--git-dir"])
    hh = project_dir / ".haex-hive.json"
    state.has_haex_hive_json = hh.exists()
    if state.has_haex_hive_json:
        try:
            content = json.loads(hh.read_text(encoding="utf-8"))
            state.haex_hive_json_content = (
                content if isinstance(content, dict) else None
            )
            errors = validate_haex_hive_config(content)
            state.haex_hive_json_valid = len(errors) == 0
        except json.JSONDecodeError:
            state.haex_hive_json_valid = False
    schema_p = project_dir / ".specify/schemas/haex-hive.schema.json"
    state.has_canonical_schema_file = schema_p.exists()
    if state.has_canonical_schema_file:
        current = schema_p.read_bytes()
        state.canonical_schema_matches_embedded = (
            hashlib.sha256(current).hexdigest()
            == hashlib.sha256(EMBEDDED_SCHEMA_JSON.encode("utf-8")).hexdigest()
        )
    state.has_constitution_file = (
        project_dir / ".specify/memory/constitution.md"
    ).exists()
    vs = project_dir / ".vscode/settings.json"
    state.has_vscode_settings = vs.exists()
    if state.has_vscode_settings:
        state.vscode_settings_wired = _vscode_entry_present(vs)
    idea = project_dir / ".idea/jsonSchemas.xml"
    state.has_idea_json_schemas = idea.exists()
    if state.has_idea_json_schemas:
        state.idea_json_schemas_wired = _idea_entry_present(idea)
    if state.is_git_repo:
        state.idea_is_gitignored = _run_git_check(
            project_dir, ["check-ignore", ".idea/"]
        )
    gi = project_dir / ".gitignore"
    if gi.exists():
        existing = set(
            line.strip() for line in gi.read_text(encoding="utf-8").splitlines()
        )
        state.gitignore_missing_patterns = [
            pat for pat in GITIGNORE_REQUIRED_PATTERNS if pat not in existing
        ]
    else:
        state.gitignore_missing_patterns = list(GITIGNORE_REQUIRED_PATTERNS)
    return state


@dataclass
class UserGlobalState:
    home: Path
    haex_hive_dir_exists: bool = False
    instructions_file_exists: bool = False
    instructions_matches_embedded: bool | None = None
    version_file_exists: bool = False
    version_file_content: str | None = None
    per_tool_marker_states: dict[str, MarkerBlockState] = field(default_factory=dict)


def snapshot_user_global(
    home: Path, selected_llms: list[DetectedTool]
) -> UserGlobalState:
    state = UserGlobalState(home=home)
    hh_dir = home / ".haex-hive"
    state.haex_hive_dir_exists = hh_dir.is_dir()
    inst = hh_dir / "haex-hive.md"
    state.instructions_file_exists = inst.exists()
    if state.instructions_file_exists:
        current = inst.read_bytes()
        state.instructions_matches_embedded = (
            hashlib.sha256(current).hexdigest() == INSTRUCTIONS_SHA256
        )
    ver = hh_dir / "VERSION"
    state.version_file_exists = ver.exists()
    if state.version_file_exists:
        state.version_file_content = ver.read_text(encoding="utf-8").strip()
    for tool in selected_llms:
        if tool.user_global_config_file is None:
            continue
        state.per_tool_marker_states[tool.name] = detect_marker_block(
            tool.user_global_config_file
        )
    return state


# ---------------------------------------------------------------------------
# Small subprocess helpers
# ---------------------------------------------------------------------------


def _run_git_check(project_dir: Path, args: list[str]) -> bool:
    """Return True if `git <args>` returned 0 in project_dir."""
    try:
        r = subprocess.run(
            ["git"] + args,
            cwd=project_dir,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return r.returncode == 0
    except FileNotFoundError:
        return False


def _run_git_capture(project_dir: Path, args: list[str]) -> tuple[int, str, str]:
    r = subprocess.run(
        ["git"] + args,
        cwd=project_dir,
        capture_output=True,
        text=True,
        check=False,
    )
    return r.returncode, r.stdout, r.stderr


# ---------------------------------------------------------------------------
# VSCode + JetBrains helpers
# ---------------------------------------------------------------------------


VSCODE_CANONICAL_ENTRY = {
    "fileMatch": [".haex-hive.json"],
    "url": "./.specify/schemas/haex-hive.schema.json",
}


def _vscode_entry_present(settings_path: Path) -> bool:
    try:
        data = json.loads(settings_path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return False
    schemas = data.get("json.schemas") if isinstance(data, dict) else None
    if not isinstance(schemas, list):
        return False
    for entry in schemas:
        if not isinstance(entry, dict):
            continue
        fm = entry.get("fileMatch")
        if isinstance(fm, list) and ".haex-hive.json" in fm:
            if entry.get("url") == VSCODE_CANONICAL_ENTRY["url"]:
                return True
    return False


def compose_vscode_settings(existing_bytes: bytes | None) -> bytes:
    """Return the merged .vscode/settings.json bytes.

    Fails loud on invalid JSON (SC-002 spirit) — the caller must
    already have decided this file is safe to merge. The merge itself
    inserts the canonical entry only if it is not already present with
    the same url.
    """
    if existing_bytes is None:
        data: dict = {}
    else:
        data = json.loads(existing_bytes.decode("utf-8"))
        if not isinstance(data, dict):
            raise ValueError(
                "expected .vscode/settings.json to be a JSON object, got "
                f"{type(data).__name__}"
            )
    schemas = data.get("json.schemas")
    if schemas is None:
        schemas = []
        data["json.schemas"] = schemas
    if not isinstance(schemas, list):
        raise ValueError(
            "expected 'json.schemas' in .vscode/settings.json to be an array, "
            f"got {type(schemas).__name__}"
        )
    # Look for an existing entry mentioning .haex-hive.json.
    for entry in schemas:
        if isinstance(entry, dict):
            fm = entry.get("fileMatch")
            if isinstance(fm, list) and ".haex-hive.json" in fm:
                entry["url"] = VSCODE_CANONICAL_ENTRY["url"]
                if ".haex-hive.json" not in fm:
                    fm.append(".haex-hive.json")
                break
    else:
        schemas.append(dict(VSCODE_CANONICAL_ENTRY))
    serialized = json.dumps(data, indent=2, ensure_ascii=False, sort_keys=False)
    return (serialized + "\n").encode("utf-8")


IDEA_CANONICAL_XML = (
    "<?xml version='1.0' encoding='UTF-8'?>\n"
    '<project version="4">\n'
    '  <component name="JsonSchemaMappingsProjectConfiguration">\n'
    "    <state>\n"
    "      <map>\n"
    '        <entry key="haex-hive">\n'
    "          <value>\n"
    "            <SchemaInfo>\n"
    '              <option name="name" value="haex-hive" />\n'
    '              <option name="relativePathToSchema" value=".specify/schemas/haex-hive.schema.json" />\n'
    '              <option name="schemaVersion" value="JSON Schema version 7" />\n'
    '              <option name="patterns">\n'
    "                <list>\n"
    "                  <Item>\n"
    '                    <option name="path" value=".haex-hive.json" />\n'
    "                  </Item>\n"
    "                </list>\n"
    "              </option>\n"
    "            </SchemaInfo>\n"
    "          </value>\n"
    "        </entry>\n"
    "      </map>\n"
    "    </state>\n"
    "  </component>\n"
    "</project>\n"
)


def _idea_entry_present(xml_path: Path) -> bool:
    try:
        tree = ET.parse(xml_path)
    except (ET.ParseError, OSError):
        return False
    root = tree.getroot()
    for entry in root.iter("entry"):
        if entry.get("key") == "haex-hive":
            for opt in entry.iter("option"):
                if (
                    opt.get("name") == "relativePathToSchema"
                    and opt.get("value")
                    == ".specify/schemas/haex-hive.schema.json"
                ):
                    return True
    return False


def _localname(tag: str) -> str:
    """Strip any {namespace} prefix ElementTree stamps on element tags."""
    return tag.rsplit("}", 1)[-1] if "}" in tag else tag


def _find_child_by_localname(parent: ET.Element, local: str) -> ET.Element | None:
    for child in parent:
        if _localname(child.tag) == local:
            return child
    return None


def _find_children_by_localname(parent: ET.Element, local: str) -> list[ET.Element]:
    return [c for c in parent if _localname(c.tag) == local]


def compose_idea_xml(existing_bytes: bytes | None) -> bytes:
    """Return merged .idea/jsonSchemas.xml bytes.

    Matches every element by local name so IntelliJ-style documents that
    stamp a namespace on the root (or any subordinate element) still
    parse; the original namespace is preserved on re-serialize because
    we mutate the parsed tree in place rather than rewriting tag names.
    """
    if existing_bytes is None:
        return IDEA_CANONICAL_XML.encode("utf-8")
    root = ET.fromstring(existing_bytes.decode("utf-8"))
    if _localname(root.tag) != "project":
        raise ValueError("unexpected XML root element in .idea/jsonSchemas.xml")
    # Preserve the root's default namespace on re-serialize. ET would
    # otherwise emit a synthesized `ns0:` prefix for a namespaced input;
    # registering the URI with the empty prefix keeps the original
    # `xmlns="…"` shape and lets us mutate the tree in place.
    root_ns = root.tag[1:].split("}", 1)[0] if root.tag.startswith("{") else ""
    if root_ns:
        ET.register_namespace("", root_ns)
    def _tag(local: str) -> str:
        return f"{{{root_ns}}}{local}" if root_ns else local

    component = None
    for c in _find_children_by_localname(root, "component"):
        if c.get("name") == "JsonSchemaMappingsProjectConfiguration":
            component = c
            break
    if component is None:
        component = ET.SubElement(
            root, _tag("component"),
            {"name": "JsonSchemaMappingsProjectConfiguration"},
        )
    state = _find_child_by_localname(component, "state")
    if state is None:
        state = ET.SubElement(component, _tag("state"))
    _map = _find_child_by_localname(state, "map")
    if _map is None:
        _map = ET.SubElement(state, _tag("map"))
    existing_entry = None
    for entry in _find_children_by_localname(_map, "entry"):
        if entry.get("key") == "haex-hive":
            existing_entry = entry
            break
    canonical_entry_root = ET.fromstring(IDEA_CANONICAL_XML)
    canonical_entry = canonical_entry_root.find(
        "component/state/map/entry[@key='haex-hive']"
    )
    if canonical_entry is None:
        raise RuntimeError("canonical IDEA XML is corrupt")
    if root_ns:
        # Rebuild the canonical entry's subtree under the document's
        # namespace so the merged file stays namespace-consistent.
        def _rens(el: ET.Element) -> ET.Element:
            new = ET.Element(_tag(_localname(el.tag)), dict(el.attrib))
            new.text = el.text
            new.tail = el.tail
            for child in el:
                new.append(_rens(child))
            return new
        canonical_entry = _rens(canonical_entry)
    if existing_entry is not None:
        _map.remove(existing_entry)
    _map.append(canonical_entry)
    ET.indent(root, space="  ", level=0)
    body = ET.tostring(root, encoding="utf-8", xml_declaration=False)
    return b"<?xml version='1.0' encoding='UTF-8'?>\n" + body + b"\n"


# ---------------------------------------------------------------------------
# Action framework (T013)
# ---------------------------------------------------------------------------


class ActionKind(str, Enum):
    CREATE_FILE = "CREATE_FILE"
    MERGE_JSON = "MERGE_JSON"
    MERGE_XML = "MERGE_XML"
    APPEND_BLOCK = "APPEND_BLOCK"
    REPLACE_BLOCK = "REPLACE_BLOCK"
    APPEND_GITIGNORE_LINES = "APPEND_GITIGNORE_LINES"
    GIT_INIT = "GIT_INIT"
    GIT_COMMIT = "GIT_COMMIT"
    PATCH_HAEX_HIVE_JSON = "PATCH_HAEX_HIVE_JSON"


@dataclass
class Action:
    kind: ActionKind
    target: Path
    preview: str
    execute: Callable[[], None]
    label: str
    group: str = "Project-level"
    # Runtime-set fields:
    outcome: str = "pending"  # "applied" | "skipped" | "pending"


@dataclass
class ActionPlan:
    actions: list[Action] = field(default_factory=list)
    next_steps: list[str] = field(default_factory=list)
    git_commit_result: str | None = None

    def add(self, action: Action) -> None:
        self.actions.append(action)


def confirm(prompt: str, default_yes: bool = True, auto_yes: bool = False) -> bool:
    """Present a Y/N prompt; return True on confirm.

    default_yes controls how the prompt renders ([Y/n] vs [y/N]) and
    what the empty answer means. auto_yes bypasses the prompt.
    """
    if auto_yes:
        return True
    suffix = "[Y/n]" if default_yes else "[y/N]"
    while True:
        try:
            resp = input(f"{prompt} {suffix}: ").strip().lower()
        except EOFError:
            return default_yes
        if resp == "":
            return default_yes
        if resp in ("y", "yes"):
            return True
        if resp in ("n", "no"):
            return False


# ---------------------------------------------------------------------------
# Prompts (T018, T019)
# ---------------------------------------------------------------------------


def prompt_tool_selection(detected: list[DetectedTool]) -> list[DetectedTool]:
    """Prompt operator for tool selection per contracts/haex-init.cli.md
    Prompt 1. Re-prompt up to 3 times on malformed input then exit 2.
    """
    if not detected:
        print("No LLM or IDE tools detected. Nothing to wire.")
        return []
    llm_tools = sorted(
        (t for t in detected if t.category == "llm"), key=lambda t: t.name
    )
    ide_tools = sorted(
        (t for t in detected if t.category == "ide"), key=lambda t: t.name
    )
    ordered = llm_tools + ide_tools
    print("Detected tools:")
    for i, t in enumerate(ordered, start=1):
        label = "LLM" if t.category == "llm" else "IDE"
        force = " (--include)" if t.force_included else ""
        print(f"  [{i}] {t.name:<16} ({label}){force}")
    print("")
    attempts = 0
    while attempts < 3:
        try:
            resp = input(
                'Which should haex-hive wire into? (comma-separated numbers, '
                '"all", "none") [all]: '
            ).strip().lower()
        except EOFError:
            resp = ""
        if resp == "" or resp == "all":
            return ordered
        if resp == "none":
            return []
        tokens = [t.strip() for t in resp.split(",") if t.strip()]
        picks: list[DetectedTool] = []
        bad = False
        for tok in tokens:
            if not tok.isdigit():
                bad = True
                break
            idx = int(tok)
            if idx < 1 or idx > len(ordered):
                bad = True
                break
            picks.append(ordered[idx - 1])
        if bad or not picks:
            print(
                "haex-init: could not parse selection. "
                'Enter comma-separated numbers, "all", or "none".',
                file=sys.stderr,
            )
            attempts += 1
            continue
        # Deduplicate preserving order.
        seen: set[str] = set()
        unique: list[DetectedTool] = []
        for p in picks:
            if p.name in seen:
                continue
            seen.add(p.name)
            unique.append(p)
        return unique
    print("haex-init: tool selection failed after 3 attempts", file=sys.stderr)
    sys.exit(EXIT_REFUSED)


def prompt_constitution_mode() -> str:
    """Return 'self-ref' or 'external-ref' per Prompt 2."""
    print("")
    print("Constitution mode:")
    print(
        "  [1] self-ref: this project owns its constitution "
        "(.specify/memory/constitution.md)"
    )
    print(
        "  [2] external-ref: this project references a constitution in another repo"
    )
    attempts = 0
    while attempts < 3:
        try:
            resp = input("Choose [1/2] [1]: ").strip()
        except EOFError:
            resp = ""
        if resp == "" or resp == "1":
            return "self-ref"
        if resp == "2":
            return "external-ref"
        print(
            "haex-init: enter '1' or '2'.",
            file=sys.stderr,
        )
        attempts += 1
    print("haex-init: constitution-mode selection failed", file=sys.stderr)
    sys.exit(EXIT_REFUSED)


# ---------------------------------------------------------------------------
# External-ref verification (T033–T036)
# ---------------------------------------------------------------------------


def validate_external_url(url: str) -> str | None:
    """Return an error message if url has a rejected scheme, else None."""
    if url.startswith("file://"):
        return (
            "URL scheme file:// is not accepted (identity is device-dependent). "
            "Use https://, ssh://, or an SCP-style user@host:path URL."
        )
    if url.startswith("git://"):
        return (
            "URL scheme git:// is not accepted (unauthenticated, deprecated). "
            "Use https://, ssh://, or SCP-style user@host:path."
        )
    if url.startswith("http://"):
        return (
            "URL scheme http:// is not accepted (unencrypted). "
            "Use https://, ssh://, or SCP-style user@host:path."
        )
    if not URL_SCHEME_RE.match(url):
        return (
            "URL does not match any accepted scheme "
            "(https://, ssh://, or user@host:path)."
        )
    return None


def validate_external_sha(sha: str) -> str | None:
    """Return an error message if sha does not match the schema, else None."""
    if not SHA_RE.match(sha):
        return "SHA must be 7-40 lowercase hex characters."
    return None


def _cache_dir_for(url: str) -> Path:
    xdg = os.environ.get("XDG_CACHE_HOME")
    home = Path(os.environ.get("HOME", "~")).expanduser()
    base = Path(xdg) if xdg else home / ".cache"
    slug = hashlib.sha256(url.encode("utf-8")).hexdigest()[:16]
    return base / "haex-init" / "verify" / slug


def verify_external_ref(url: str, sha: str, path: str) -> tuple[bool, str]:
    """Run the pre-write verification per research Decision 3.

    Returns (ok, message). On ok the message is empty; on failure it
    is the raw stderr from the failing git call (or an equivalent
    explanation).
    """
    cache = _cache_dir_for(url)
    try:
        cache.mkdir(parents=True, exist_ok=True)
        if not (cache / "HEAD").exists():
            init = subprocess.run(
                ["git", "init", "--bare", "--quiet", str(cache)],
                capture_output=True,
                text=True,
                check=False,
            )
            if init.returncode != 0:
                return False, init.stderr.strip() or "git init failed"
        fetch = subprocess.run(
            ["git", "-C", str(cache), "fetch", "--no-tags", "--depth=1", url, sha],
            capture_output=True,
            text=True,
            check=False,
        )
        if fetch.returncode != 0:
            return False, fetch.stderr.strip() or "git fetch failed"
        exists = subprocess.run(
            ["git", "-C", str(cache), "cat-file", "-e", f"{sha}:{path}"],
            capture_output=True,
            text=True,
            check=False,
        )
        if exists.returncode != 0:
            return False, exists.stderr.strip() or (
                f"path {path} not found at {sha}"
            )
        size = subprocess.run(
            ["git", "-C", str(cache), "cat-file", "-s", f"{sha}:{path}"],
            capture_output=True,
            text=True,
            check=False,
        )
        if size.returncode != 0:
            return False, size.stderr.strip() or "cat-file -s failed"
        try:
            n = int(size.stdout.strip())
        except ValueError:
            return False, f"cat-file -s returned unparseable output: {size.stdout!r}"
        if n == 0:
            return False, f"path {path} at {sha} is empty (0 bytes)"
        return True, ""
    except FileNotFoundError:
        return False, "git executable not found on PATH"


# ---------------------------------------------------------------------------
# Action-plan builders
# ---------------------------------------------------------------------------


def plan_operator_level(
    plan: ActionPlan,
    home: Path,
    user_state: UserGlobalState,
    selected_llms: list[DetectedTool],
) -> None:
    """Add Actions for ~/.haex-hive/ + per-LLM marker blocks (T020, T021)."""
    hh_dir = home / ".haex-hive"

    inst = hh_dir / "haex-hive.md"
    if (
        not user_state.instructions_file_exists
        or user_state.instructions_matches_embedded is False
    ):
        content = CANONICAL_SESSION_INSTRUCTIONS.encode("utf-8")
        existing = inst.read_bytes() if inst.exists() else b""
        preview = render_unified_diff(existing, content, str(inst))

        def _apply(target: Path = inst, blob: bytes = content) -> None:
            atomic_write(target, blob)

        plan.add(
            Action(
                kind=ActionKind.CREATE_FILE,
                target=inst,
                preview=preview
                or f"create {inst} (canonical session instructions, "
                f"v={INSTRUCTIONS_VERSION})",
                execute=_apply,
                label=f"created ~/.haex-hive/haex-hive.md",
                group="Operator-level",
            )
        )

    ver = hh_dir / "VERSION"
    ver_content = (INSTRUCTIONS_VERSION + "\n").encode("utf-8")
    ver_current = ver.read_bytes() if ver.exists() else b""
    if ver_current != ver_content:
        preview = render_unified_diff(ver_current, ver_content, str(ver))

        def _apply_ver(target: Path = ver, blob: bytes = ver_content) -> None:
            atomic_write(target, blob)

        plan.add(
            Action(
                kind=ActionKind.CREATE_FILE,
                target=ver,
                preview=preview or f"create {ver} (v={INSTRUCTIONS_VERSION})",
                execute=_apply_ver,
                label=f"created ~/.haex-hive/VERSION (v={INSTRUCTIONS_VERSION})",
                group="Operator-level",
            )
        )

    for tool in selected_llms:
        if tool.user_global_config_file is None:
            continue
        marker = user_state.per_tool_marker_states.get(
            tool.name,
            detect_marker_block(tool.user_global_config_file),
        )
        _plan_marker_action(plan, tool, marker)


def _plan_marker_action(
    plan: ActionPlan, tool: DetectedTool, marker: MarkerBlockState
) -> None:
    target = marker.target_file
    if marker.presence is MarkerPresence.MALFORMED:
        # Refuse before any Action has run so partial state cannot accumulate,
        # and so an operator declining a prompt cannot mask exit 2.
        print(f"haex-init: {marker.malformed_reason}", file=sys.stderr)
        sys.exit(EXIT_REFUSED)
    if marker.presence is MarkerPresence.PRESENT_MATCHING_VERSION:
        return
    if marker.presence is MarkerPresence.ABSENT:
        existing = target.read_bytes() if target.exists() else b""
        new_bytes = compose_appended_block(existing)
        preview = render_unified_diff(existing, new_bytes, str(target))

        def _apply(t: Path = target, blob: bytes = new_bytes) -> None:
            atomic_write(t, blob)

        plan.add(
            Action(
                kind=ActionKind.APPEND_BLOCK,
                target=target,
                preview=preview,
                execute=_apply,
                label=(
                    f"appended marker block v={INSTRUCTIONS_VERSION} to {target}"
                ),
                group="Operator-level",
            )
        )
        return
    if marker.presence is MarkerPresence.PRESENT_MISMATCHED_VERSION:
        existing = target.read_bytes()
        new_bytes = compose_replaced_block(existing, marker)
        preview = render_unified_diff(existing, new_bytes, str(target))

        def _apply_repl(t: Path = target, blob: bytes = new_bytes) -> None:
            atomic_write(t, blob)

        plan.add(
            Action(
                kind=ActionKind.REPLACE_BLOCK,
                target=target,
                preview=preview,
                execute=_apply_repl,
                label=(
                    f"replaced marker block "
                    f"v={marker.existing_version}→v={INSTRUCTIONS_VERSION} in {target}"
                ),
                group="Operator-level",
            )
        )
        return


def plan_project_level(
    plan: ActionPlan,
    project_dir: Path,
    project_state: ProjectState,
    selected: list[DetectedTool],
    mode: str,
    external_ref: dict | None,
    identity_value: str,
) -> None:
    """Plan project-level actions per FR-011..FR-016 + FR-021..FR-025.

    mode: 'self-ref' or 'external-ref'. external_ref (if mode='external-ref')
    is the {url, sha, path} triple already verified.
    """
    _plan_haex_hive_json(
        plan,
        project_dir,
        project_state,
        mode,
        external_ref,
        identity_value,
        selected_tool_names=sorted(t.name for t in selected),
    )
    _plan_schema_file(plan, project_dir, project_state)
    families_selected = {t.family for t in selected}
    if "vscode-family" in families_selected:
        _plan_vscode_settings(plan, project_dir, project_state, selected)
    if "jetbrains-family" in families_selected:
        _plan_idea_jsonschemas(plan, project_dir, project_state)
    _plan_gitignore(plan, project_dir, project_state)


def _plan_haex_hive_json(
    plan: ActionPlan,
    project_dir: Path,
    project_state: ProjectState,
    mode: str,
    external_ref: dict | None,
    identity_value: str,
    *,
    selected_tool_names: list[str],
) -> None:
    target = project_dir / ".haex-hive.json"
    # Preserve pre-existing valid content (identity, harness_sources) as far
    # as possible: only mutate what this run explicitly changes.
    base: dict = {
        "haex_hive_version": "1",
        "identity": identity_value,
        "harness_sources": [],
    }
    if (
        project_state.has_haex_hive_json
        and project_state.haex_hive_json_valid
        and isinstance(project_state.haex_hive_json_content, dict)
    ):
        # Merge: keep everything the operator already had; only write the
        # empty-array default when there is no existing harness_sources.
        base = dict(project_state.haex_hive_json_content)
        base.setdefault("haex_hive_version", "1")
        base.setdefault("identity", identity_value)
        base.setdefault("harness_sources", [])
    else:
        # Fresh: prompt-derived identity_value stays.
        pass

    # Persist the operator's selection intent (see spec.md US1 §3). On a
    # subsequent --yes rerun this list is what run_init consults instead
    # of "all detected tools", so a tool the operator deliberately
    # excluded here stays excluded even if it starts appearing in
    # detection later.
    base["managed_tools"] = list(selected_tool_names)

    if mode == "external-ref" and external_ref is not None:
        # In external-ref mode we set harness_sources to a single-entry
        # array carrying the verified constitution triple.
        base["harness_sources"] = [
            {
                "role": "constitution",
                "repository": external_ref["url"],
                "revision": external_ref["sha"],
                "path": external_ref["path"],
            }
        ]

    proposed_bytes = (json.dumps(base, indent=2) + "\n").encode("utf-8")
    existing_bytes = target.read_bytes() if target.exists() else b""
    if existing_bytes == proposed_bytes:
        return
    errors = validate_haex_hive_config(base)
    if errors:
        raise RuntimeError(
            "haex-init internal error: proposed .haex-hive.json fails schema:\n  "
            + "\n  ".join(errors)
        )
    preview = render_unified_diff(existing_bytes, proposed_bytes, str(target))

    def _apply(t: Path = target, blob: bytes = proposed_bytes) -> None:
        atomic_write(t, blob)

    if mode == "self-ref":
        label = "created .haex-hive.json (self-ref, harness_sources: [])"
    else:
        label = "created .haex-hive.json (external-ref, 1 harness_source)"
    plan.add(
        Action(
            kind=ActionKind.PATCH_HAEX_HIVE_JSON,
            target=target,
            preview=preview,
            execute=_apply,
            label=label,
            group="Project-level",
        )
    )


def _plan_schema_file(
    plan: ActionPlan, project_dir: Path, project_state: ProjectState
) -> None:
    target = project_dir / ".specify/schemas/haex-hive.schema.json"
    proposed = EMBEDDED_SCHEMA_JSON.encode("utf-8")
    if project_state.has_canonical_schema_file:
        current = target.read_bytes()
        if current == proposed:
            return
        preview = render_unified_diff(current, proposed, str(target))
        label = "updated .specify/schemas/haex-hive.schema.json"
    else:
        preview = render_unified_diff(b"", proposed, str(target))
        label = "created .specify/schemas/haex-hive.schema.json"

    def _apply(t: Path = target, blob: bytes = proposed) -> None:
        atomic_write(t, blob)

    plan.add(
        Action(
            kind=ActionKind.CREATE_FILE,
            target=target,
            preview=preview,
            execute=_apply,
            label=label,
            group="Project-level",
        )
    )


def _plan_vscode_settings(
    plan: ActionPlan,
    project_dir: Path,
    project_state: ProjectState,
    selected: list[DetectedTool],
) -> None:
    target = project_dir / ".vscode/settings.json"
    existing = target.read_bytes() if target.exists() else None
    try:
        proposed = compose_vscode_settings(existing)
    except (json.JSONDecodeError, ValueError) as exc:
        print(
            f"haex-init: cannot parse {target}: {exc}",
            file=sys.stderr,
        )
        sys.exit(EXIT_REFUSED)
    if existing == proposed:
        return
    preview = render_unified_diff(existing or b"", proposed, str(target))

    def _apply(t: Path = target, blob: bytes = proposed) -> None:
        atomic_write(t, blob)

    vscode_names = sorted(
        t.name for t in selected if t.family == "vscode-family"
    )
    label = (
        f"merged json.schemas entry into .vscode/settings.json "
        f"(for {', '.join(vscode_names)})"
    )
    plan.add(
        Action(
            kind=ActionKind.MERGE_JSON,
            target=target,
            preview=preview,
            execute=_apply,
            label=label,
            group="Project-level",
        )
    )


def _plan_idea_jsonschemas(
    plan: ActionPlan, project_dir: Path, project_state: ProjectState
) -> None:
    target = project_dir / ".idea/jsonSchemas.xml"
    existing = target.read_bytes() if target.exists() else None
    try:
        proposed = compose_idea_xml(existing)
    except (ET.ParseError, ValueError) as exc:
        print(
            f"haex-init: cannot parse {target}: {exc}",
            file=sys.stderr,
        )
        sys.exit(EXIT_REFUSED)
    if existing == proposed:
        return
    preview = render_unified_diff(existing or b"", proposed, str(target))
    if project_state.idea_is_gitignored:
        preview = (
            "warning: .idea/ is gitignored; .idea/jsonSchemas.xml will "
            "not travel with the project.\n\n"
        ) + preview

    def _apply(t: Path = target, blob: bytes = proposed) -> None:
        atomic_write(t, blob)

    plan.add(
        Action(
            kind=ActionKind.MERGE_XML,
            target=target,
            preview=preview,
            execute=_apply,
            label="merged haex-hive entry into .idea/jsonSchemas.xml",
            group="Project-level",
        )
    )


def _plan_gitignore(
    plan: ActionPlan, project_dir: Path, project_state: ProjectState
) -> None:
    target = project_dir / ".gitignore"
    if not project_state.gitignore_missing_patterns:
        return
    existing = target.read_bytes() if target.exists() else b""
    missing = project_state.gitignore_missing_patterns
    to_append = ""
    if existing and not existing.endswith(b"\n"):
        to_append += "\n"
    if existing and not existing.endswith(b"\n\n"):
        to_append += "\n"
    to_append += "\n".join(missing) + "\n"
    proposed = existing + to_append.encode("utf-8")
    preview = render_unified_diff(existing, proposed, str(target))

    def _apply(t: Path = target, blob: bytes = proposed) -> None:
        atomic_write(t, blob)

    label = f"appended {', '.join(missing)} to .gitignore"
    plan.add(
        Action(
            kind=ActionKind.APPEND_GITIGNORE_LINES,
            target=target,
            preview=preview,
            execute=_apply,
            label=label,
            group="Project-level",
        )
    )


# ---------------------------------------------------------------------------
# Runner (T013 + T014)
# ---------------------------------------------------------------------------


def run_plan(
    plan: ActionPlan,
    *,
    dry_run: bool,
    auto_yes: bool,
) -> tuple[int, int]:
    """Execute the plan interactively (unless dry_run).

    Returns (applied, skipped) counts. Actions marked APPLIED update
    Action.outcome to 'applied'; skipped ones become 'skipped'.
    """
    applied = 0
    skipped = 0
    for action in plan.actions:
        header = f"---- {action.kind.value}: {action.label} ----"
        print()
        print(header)
        if action.preview:
            print(action.preview)
        if dry_run:
            action.outcome = "pending"
            skipped += 0  # dry-run does not count "skipped"; use pending marker
            continue
        if confirm("Apply this change?", default_yes=True, auto_yes=auto_yes):
            try:
                action.execute()
                action.outcome = "applied"
                applied += 1
            except SystemExit:
                raise
        else:
            action.outcome = "skipped"
            skipped += 1
    return applied, skipped


def render_report(plan: ActionPlan, *, dry_run: bool) -> str:
    """Return the action-report string per contracts/haex-init.cli.md."""
    lines: list[str] = []
    lines.append("")
    lines.append("haex-init action report")
    lines.append("=======================")
    groups = ["Operator-level", "Project-level", "Git"]
    counts_applied = 0
    counts_skipped = 0
    counts_pending = 0
    for grp in groups:
        entries = [a for a in plan.actions if a.group == grp]
        if not entries:
            continue
        lines.append("")
        lines.append(f"{grp}:")
        for a in entries:
            marker = "[x]" if a.outcome == "applied" else (
                "[?]" if a.outcome == "pending" else "[-]"
            )
            lines.append(f"  {marker}  {a.label}")
            if a.outcome == "applied":
                counts_applied += 1
            elif a.outcome == "skipped":
                counts_skipped += 1
            else:
                counts_pending += 1
    if plan.next_steps:
        lines.append("")
        lines.append("Next steps:")
        for i, step in enumerate(plan.next_steps, start=1):
            for j, sub in enumerate(step.splitlines()):
                if j == 0:
                    lines.append(f"  {i}. {sub}")
                else:
                    lines.append(f"     {sub}")
    lines.append("")
    if dry_run:
        lines.append(
            f"haex-init: {counts_pending} action(s) pending (dry-run), "
            f"{counts_skipped} skipped"
        )
    else:
        lines.append(
            f"haex-init: {counts_applied} action(s) applied, {counts_skipped} skipped"
        )
    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------------------
# Git actions
# ---------------------------------------------------------------------------


def add_git_init_action(plan: ActionPlan, project_dir: Path) -> None:
    def _apply(pd: Path = project_dir) -> None:
        r = subprocess.run(
            ["git", "init", "--quiet"],
            cwd=pd,
            capture_output=True,
            text=True,
            check=False,
        )
        if r.returncode != 0:
            print(
                f"haex-init: git init failed: {r.stderr.strip()}",
                file=sys.stderr,
            )
            sys.exit(EXIT_GIT)

    plan.add(
        Action(
            kind=ActionKind.GIT_INIT,
            target=project_dir,
            preview=f"initialize git repository at {project_dir}",
            execute=_apply,
            label="initialized git repository",
            group="Git",
        )
    )


def add_git_commit_action(
    plan: ActionPlan, project_dir: Path, message: str, paths: list[Path]
) -> None:
    def _apply(
        pd: Path = project_dir,
        msg: str = message,
        rel_paths: list[Path] = paths,
    ) -> None:
        rels: list[str] = []
        for p in rel_paths:
            # A declined prompt (or a skipped GIT_INIT) leaves the target
            # off disk. Passing it to `git add` would fail with a pathspec
            # error and mask the operator's decision. Silently skip.
            if not p.exists():
                continue
            try:
                rels.append(str(p.relative_to(pd)))
            except ValueError:
                continue
        if rels:
            add = subprocess.run(
                ["git", "add", "--"] + rels,
                cwd=pd,
                capture_output=True,
                text=True,
                check=False,
            )
            if add.returncode != 0:
                print(
                    f"haex-init: git add failed: {add.stderr.strip()}",
                    file=sys.stderr,
                )
                sys.exit(EXIT_GIT)
        # If nothing is staged (rerun recreated files that already match HEAD),
        # skip the commit — this is idempotent, not a failure.
        staged = subprocess.run(
            ["git", "diff", "--cached", "--quiet"],
            cwd=pd,
            capture_output=True,
            text=True,
            check=False,
        )
        if staged.returncode == 0:
            plan.git_commit_result = "no changes to commit (working tree clean)"
            return
        commit = subprocess.run(
            ["git", "commit", "-m", msg, "--quiet"],
            cwd=pd,
            capture_output=True,
            text=True,
            check=False,
        )
        if commit.returncode != 0:
            print(
                f"haex-init: git commit failed: "
                f"{commit.stderr.strip() or commit.stdout.strip()}",
                file=sys.stderr,
            )
            sys.exit(EXIT_GIT)
        head = subprocess.run(
            ["git", "-C", str(pd), "rev-parse", "--short", "HEAD"],
            capture_output=True,
            text=True,
            check=False,
        )
        short = head.stdout.strip() or "(unknown)"
        plan.git_commit_result = f"commit {short}: {msg}"

    plan.add(
        Action(
            kind=ActionKind.GIT_COMMIT,
            target=project_dir,
            preview=(
                f"git add + git commit -m {json.dumps(message)}\n"
                f"paths: {', '.join(str(p) for p in paths)}"
            ),
            execute=_apply,
            label=f"scaffolding commit ({message})",
            group="Git",
        )
    )


# ---------------------------------------------------------------------------
# Identity derivation
# ---------------------------------------------------------------------------


def derive_identity(project_dir: Path) -> str:
    """Return identity string per Spec 003 shape.

    Precedence: (1) git remote 'origin' URL, (2) `local:<basename>`.
    """
    if _run_git_check(project_dir, ["rev-parse", "--git-dir"]):
        rc, out, _ = _run_git_capture(
            project_dir, ["config", "--get", "remote.origin.url"]
        )
        if rc == 0 and out.strip():
            return out.strip()
    return f"local:{project_dir.name}"


# ---------------------------------------------------------------------------
# External-ref prompting
# ---------------------------------------------------------------------------


def _validate_external_path(p: str) -> str | None:
    if not p:
        return "path must be non-empty"
    return None


def resolve_external_ref_from_flags(args: argparse.Namespace) -> dict:
    """Build the external-ref triple from CLI flags (non-interactive).

    Called when --constitution-mode=external-ref is passed (typically with
    --yes) so external-ref mode can run without prompting. Exits
    EXIT_REFUSED if any field is missing or fails validation.
    """
    url = args.constitution_url
    sha = args.constitution_sha
    path = args.constitution_path or ".specify/memory/constitution.md"
    missing = [
        name
        for name, val in (("--constitution-url", url), ("--constitution-sha", sha))
        if not val
    ]
    if missing:
        print(
            "haex-init: --constitution-mode=external-ref requires "
            + " and ".join(missing),
            file=sys.stderr,
        )
        sys.exit(EXIT_REFUSED)
    for label, value, validator in (
        ("--constitution-url", url, validate_external_url),
        ("--constitution-sha", sha, validate_external_sha),
        ("--constitution-path", path, _validate_external_path),
    ):
        err = validator(value)
        if err:
            print(f"haex-init: {label}: {err}", file=sys.stderr)
            sys.exit(EXIT_REFUSED)
    return {"url": url, "sha": sha, "path": path}


def prompt_external_ref(*, allow_network: bool = True) -> dict:
    """Prompt for {url, sha, path}, validating each pre-network.

    Bounded to 3 attempts per field to prevent runaway.
    """
    # URL.
    url = _prompt_field(
        "External repository URL",
        validator=validate_external_url,
        default=None,
    )
    # Optional ls-remote assist. Skipped in --dry-run so the plan is built
    # without touching the network.
    if allow_network:
        try:
            fetch_latest = input("Fetch latest HEAD SHA from remote? [y/N]: ").strip().lower()
        except EOFError:
            fetch_latest = ""
    else:
        fetch_latest = ""
    default_sha = None
    if fetch_latest in ("y", "yes"):
        r = subprocess.run(
            ["git", "ls-remote", url, "HEAD"],
            capture_output=True,
            text=True,
            check=False,
        )
        if r.returncode == 0 and r.stdout.strip():
            first_line = r.stdout.strip().split("\n")[0]
            token = first_line.split()[0]
            if SHA_RE.match(token):
                default_sha = token
                print(f"  ls-remote HEAD → {token}")
        else:
            print(
                f"  ls-remote failed: {r.stderr.strip() or 'no HEAD returned'}",
                file=sys.stderr,
            )
    sha = _prompt_field(
        "SHA (7-40 lowercase hex)",
        validator=validate_external_sha,
        default=default_sha,
    )
    path = _prompt_field(
        "Path within repository",
        validator=lambda p: (
            None if p and len(p) > 0 else "path must be non-empty"
        ),
        default=".specify/memory/constitution.md",
    )
    return {"url": url, "sha": sha, "path": path}


def _prompt_field(
    label: str,
    *,
    validator: Callable[[str], str | None],
    default: str | None,
) -> str:
    attempts = 0
    while attempts < 3:
        suffix = f" [{default}]" if default else ""
        try:
            resp = input(f"{label}{suffix}: ").strip()
        except EOFError:
            resp = ""
        if resp == "" and default is not None:
            resp = default
        err = validator(resp)
        if err is None:
            return resp
        print(f"haex-init: {err}", file=sys.stderr)
        attempts += 1
    print(
        f"haex-init: field {label!r} did not validate after 3 attempts",
        file=sys.stderr,
    )
    sys.exit(EXIT_REFUSED)


# ---------------------------------------------------------------------------
# Top-level flows
# ---------------------------------------------------------------------------


def _read_persisted_managed_tools(project_state: ProjectState) -> set[str] | None:
    """Return the operator's persisted tool selection, or None if absent.

    Absent means either no prior .haex-hive.json existed, or one existed
    but predates the managed_tools field (legacy). Both are treated as
    "no persisted intent" so --yes falls back to detect-all.
    """
    if not (
        project_state.has_haex_hive_json
        and project_state.haex_hive_json_valid
        and isinstance(project_state.haex_hive_json_content, dict)
    ):
        return None
    val = project_state.haex_hive_json_content.get("managed_tools")
    if val is None:
        return None
    if not isinstance(val, list):
        return None
    result = {v for v in val if isinstance(v, str) and v in ALL_TOOL_NAMES}
    return result if result else None


def run_init(args: argparse.Namespace) -> int:
    home = _resolve_home()
    project_dir = Path.cwd().resolve()

    # --include parsing (T009).
    include_set: set[str] = set()
    if args.include:
        for name in args.include.split(","):
            n = name.strip().lower()
            if not n:
                continue
            if n not in ALL_TOOL_NAMES:
                print(
                    f"haex-init: unknown --include name {n!r}. "
                    f"Valid: {', '.join(sorted(ALL_TOOL_NAMES))}",
                    file=sys.stderr,
                )
                return EXIT_REFUSED
            include_set.add(n)

    # Refuse to run if $HOME is missing or unwritable.
    if not home.exists():
        print(
            f"haex-init: $HOME ({home}) does not exist; refusing to run.",
            file=sys.stderr,
        )
        return EXIT_REFUSED

    # Non-TTY guard (T014).
    if not sys.stdin.isatty() and not args.yes:
        print(
            "haex-init: refusing to run non-interactively without --yes",
            file=sys.stderr,
        )
        return EXIT_REFUSED

    # Snapshot project state early so tool selection can honour a persisted
    # `managed_tools` list from a prior run (see spec.md US1 §3).
    project_state = snapshot_project(project_dir)
    if project_state.has_haex_hive_json and project_state.haex_hive_json_valid is False:
        errors = validate_haex_hive_config(project_state.haex_hive_json_content or {})
        joined = "\n  ".join(errors) if errors else "invalid JSON"
        print(
            f"haex-init: existing .haex-hive.json is schema-invalid; refuse to touch it.\n  {joined}",
            file=sys.stderr,
        )
        return EXIT_REFUSED

    # Detection.
    detected = detect_tools(home, include_set)

    # Prompt tool selection unless --yes.
    #   With --yes and a persisted `managed_tools`: reuse that list
    #   verbatim (respects deliberate omissions across reruns).
    #   With --yes and no persisted list: all detected tools (legacy).
    #   Without --yes: multi-select prompt.
    persisted_managed = _read_persisted_managed_tools(project_state)
    if args.yes:
        if persisted_managed is not None:
            selected = [t for t in detected if t.name in persisted_managed]
            missing = persisted_managed - {t.name for t in selected}
            if missing:
                print(
                    "haex-init: persisted managed_tools include names that "
                    "are no longer detected: " + ", ".join(sorted(missing))
                    + " — reconfiguring the remainder only.",
                    file=sys.stderr,
                )
        else:
            selected = detected
    else:
        selected = prompt_tool_selection(detected)

    selected_llms = [t for t in selected if t.category == "llm"]

    user_state = snapshot_user_global(home, selected_llms)

    # Constitution mode resolution:
    #   1. --constitution-mode flag wins (self-ref or external-ref).
    #   2. Otherwise --yes forces self-ref (no interactive fallback).
    #   3. Otherwise ask.
    external_ref: dict | None = None
    if args.constitution_mode:
        mode = args.constitution_mode
        if mode == "external-ref":
            external_ref = resolve_external_ref_from_flags(args)
    elif args.yes:
        mode = "self-ref"
    else:
        mode = prompt_constitution_mode()
        if mode == "external-ref":
            external_ref = prompt_external_ref(allow_network=not args.dry_run)

    if mode == "external-ref":
        assert external_ref is not None
        if args.dry_run:
            # Contract: --dry-run never touches the network. Persist the
            # triple in the plan without verifying it.
            print("")
            print(
                f"(dry-run) skipping external-ref verification for "
                f"{external_ref['sha']}:{external_ref['path']}"
            )
        else:
            print("")
            print("Verifying reference…")
            ok, message = verify_external_ref(
                external_ref["url"], external_ref["sha"], external_ref["path"]
            )
            if not ok:
                print(
                    f"haex-init: external-ref verification failed:\n  {message}",
                    file=sys.stderr,
                )
                return EXIT_EXTERNAL_REF
            print(
                f"  ✓ reference verified at {external_ref['sha']}:{external_ref['path']}"
            )

    identity_value = (
        project_state.haex_hive_json_content.get("identity")
        if project_state.haex_hive_json_content
        and isinstance(project_state.haex_hive_json_content, dict)
        else None
    ) or derive_identity(project_dir)

    plan = ActionPlan()
    plan_operator_level(plan, home, user_state, selected_llms)
    plan_project_level(
        plan, project_dir, project_state, selected, mode, external_ref, identity_value
    )

    # Git init + commit (self-ref & external-ref). Each is added to the
    # plan as its own Action; the runner asks a single "Apply this change?"
    # Y/N per action.
    touched_paths = [a.target for a in plan.actions if a.group == "Project-level"]
    if touched_paths and not args.dry_run:
        if not project_state.is_git_repo:
            add_git_init_action(plan, project_dir)
        commit_msg = (
            "haex-init: initialize haex-hive with external constitution"
            if mode == "external-ref"
            else "haex-init: initialize haex-hive scaffolding"
        )
        add_git_commit_action(plan, project_dir, commit_msg, touched_paths)

    if mode == "self-ref":
        plan.next_steps.append(
            "Run  /speckit-constitution  in your agent session to define\n"
            "the project's constitution."
        )
        plan.next_steps.append(
            "After committing the constitution, run:\n"
            "     haex-init --pin-constitution\n"
            "to pin it in .haex-hive.json."
        )

    # If empty, short-circuit per FR-026.
    if not plan.actions:
        print("Everything in order. No actions needed.")
        return EXIT_OK

    applied, skipped = run_plan(plan, dry_run=args.dry_run, auto_yes=args.yes)
    print(render_report(plan, dry_run=args.dry_run))
    if args.dry_run:
        pending = sum(1 for a in plan.actions if a.outcome == "pending")
        return EXIT_DRY_RUN_PENDING if pending else EXIT_OK
    return EXIT_OK


def run_pin_constitution(args: argparse.Namespace) -> int:
    project_dir = Path.cwd().resolve()

    if not _run_git_check(project_dir, ["rev-parse", "--is-inside-work-tree"]):
        print(
            "haex-init --pin-constitution: not inside a git working tree",
            file=sys.stderr,
        )
        return EXIT_REFUSED

    if not sys.stdin.isatty() and not args.yes:
        print(
            "haex-init: refusing to run non-interactively without --yes",
            file=sys.stderr,
        )
        return EXIT_REFUSED

    rc, head, _ = _run_git_capture(project_dir, ["rev-parse", "HEAD"])
    if rc != 0 or not FULL_SHA_RE.match(head.strip()):
        print(
            "haex-init --pin-constitution: repository has no commits yet",
            file=sys.stderr,
        )
        return EXIT_REFUSED
    head_sha = head.strip()

    # ls-files --error-unmatch matches on the index, so a staged-but-uncommitted
    # constitution would satisfy it and we'd then pin a revision at which the
    # blob does not exist. Check the committed tree at HEAD instead.
    tracked = subprocess.run(
        [
            "git",
            "-C",
            str(project_dir),
            "cat-file",
            "-e",
            f"{head_sha}:.specify/memory/constitution.md",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if tracked.returncode != 0:
        print(
            "haex-init --pin-constitution: .specify/memory/constitution.md is "
            "not tracked at HEAD (commit it first)",
            file=sys.stderr,
        )
        return EXIT_REFUSED

    target = project_dir / ".haex-hive.json"
    if not target.exists():
        print(
            "haex-init --pin-constitution: .haex-hive.json is missing; "
            "run haex-init first.",
            file=sys.stderr,
        )
        return EXIT_REFUSED
    try:
        content = json.loads(target.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        print(
            f"haex-init --pin-constitution: cannot parse .haex-hive.json: {exc}",
            file=sys.stderr,
        )
        return EXIT_REFUSED
    if not isinstance(content, dict):
        print(
            "haex-init --pin-constitution: .haex-hive.json is not an object",
            file=sys.stderr,
        )
        return EXIT_REFUSED
    errors = validate_haex_hive_config(content)
    if errors:
        joined = "\n  ".join(errors)
        print(
            f"haex-init --pin-constitution: .haex-hive.json is schema-invalid:\n  {joined}",
            file=sys.stderr,
        )
        return EXIT_REFUSED

    existing_sources = content.get("harness_sources", [])
    if not isinstance(existing_sources, list):
        print(
            "haex-init --pin-constitution: harness_sources is not an array",
            file=sys.stderr,
        )
        return EXIT_REFUSED
    for entry in existing_sources:
        if isinstance(entry, dict) and entry.get("role") == "constitution":
            print(
                "haex-init --pin-constitution: a constitution reference is "
                "already pinned in .haex-hive.json; refusing (idempotent).",
                file=sys.stderr,
            )
            return EXIT_REFUSED

    new_content = dict(content)
    new_content["harness_sources"] = existing_sources + [
        {
            "role": "constitution",
            "repository": "self",
            "revision": head_sha,
            "path": ".specify/memory/constitution.md",
        }
    ]
    validation = validate_haex_hive_config(new_content)
    if validation:
        joined = "\n  ".join(validation)
        print(
            f"haex-init --pin-constitution: patched .haex-hive.json fails schema:\n  {joined}",
            file=sys.stderr,
        )
        return EXIT_REFUSED

    existing_bytes = target.read_bytes()
    proposed_bytes = (json.dumps(new_content, indent=2) + "\n").encode("utf-8")
    preview = render_unified_diff(existing_bytes, proposed_bytes, str(target))

    plan = ActionPlan()

    def _apply(t: Path = target, blob: bytes = proposed_bytes) -> None:
        atomic_write(t, blob)

    plan.add(
        Action(
            kind=ActionKind.PATCH_HAEX_HIVE_JSON,
            target=target,
            preview=preview,
            execute=_apply,
            label=f"added role: constitution entry to harness_sources (HEAD {head_sha[:7]})",
            group="Project-level",
        )
    )
    add_git_commit_action(
        plan, project_dir, "haex-init: pin constitution to HEAD", [target]
    )

    print(f"haex-init --pin-constitution")
    print("")
    print(f"Detected HEAD at {head_sha[:7]}.")
    print("Detected .specify/memory/constitution.md tracked at HEAD.")

    applied, skipped = run_plan(plan, dry_run=False, auto_yes=args.yes)
    print(render_report(plan, dry_run=False))
    return EXIT_OK


def _resolve_home() -> Path:
    home = os.environ.get("HOME")
    if not home:
        print(
            "haex-init: $HOME is not set; refusing to run.",
            file=sys.stderr,
        )
        sys.exit(EXIT_REFUSED)
    return Path(home).expanduser().resolve()


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="haex-init",
        description=(
            "CLI-driven project initialization for haex-hive. "
            "See docs/haex-init.md for the full contract."
        ),
    )
    p.add_argument(
        "--dry-run",
        action="store_true",
        help="Compute the ActionPlan, print it, exit 0 if empty or 1 if non-empty.",
    )
    p.add_argument(
        "--yes",
        action="store_true",
        help="Auto-confirm every Y/N prompt.",
    )
    p.add_argument(
        "--include",
        metavar="NAME[,NAME...]",
        help=(
            "Force-include tools not surfaced by detection. Valid names: "
            + ", ".join(sorted(ALL_TOOL_NAMES))
            + "."
        ),
    )
    p.add_argument(
        "--pin-constitution",
        action="store_true",
        help=(
            "Run the post-/speckit-constitution wiring step: read HEAD SHA, "
            "add role: constitution entry, offer commit. Mutually exclusive "
            "with --dry-run."
        ),
    )
    p.add_argument(
        "--constitution-mode",
        choices=["self-ref", "external-ref"],
        default=None,
        help=(
            "Select constitution mode non-interactively. With --yes this is "
            "the only way to run external-ref. With external-ref, "
            "--constitution-url and --constitution-sha are required."
        ),
    )
    p.add_argument(
        "--constitution-url",
        default=None,
        help="External-ref: repository URL (https://, ssh://, user@host:path).",
    )
    p.add_argument(
        "--constitution-sha",
        default=None,
        help="External-ref: 7-40 lowercase hex SHA to pin.",
    )
    p.add_argument(
        "--constitution-path",
        default=None,
        help=(
            "External-ref: path within the referenced repo "
            "(defaults to .specify/memory/constitution.md)."
        ),
    )
    p.add_argument(
        "--version",
        action="store_true",
        help="Print version and exit.",
    )
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if args.version:
        print(f"haex-init v{INSTRUCTIONS_VERSION}")
        return EXIT_OK
    if args.pin_constitution and args.dry_run:
        print(
            "haex-init: --pin-constitution and --dry-run are mutually exclusive",
            file=sys.stderr,
        )
        return EXIT_REFUSED
    if args.pin_constitution:
        return run_pin_constitution(args)
    return run_init(args)


if __name__ == "__main__":
    sys.exit(main())
