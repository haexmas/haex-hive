"""post-commit hook entrypoint (shebang written by install.py at install time).

Per contracts/git-hooks.md §post-commit:
1. no-op unless the current branch is in the tracked-branch set;
2. call ``_refresh.refresh()`` on the repo root;
3. **always exit 0**, regardless of whether the refresh succeeded — the commit
   has already happened and this hook must never affect its outcome.
"""

from __future__ import annotations

import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
if str(_HERE) not in sys.path:
    sys.path.insert(0, str(_HERE))

import _refresh  # noqa: E402
import _tracked_branches  # noqa: E402


def _repo_root() -> Path | None:
    return _tracked_branches._repo_root(Path.cwd())


def main() -> int:
    root = _repo_root()
    if root is None:
        return 0
    branch = _tracked_branches.current_branch(root)
    if branch is None or not _tracked_branches.is_tracked(branch, root):
        return 0
    _refresh.refresh(root)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
