{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haexmas/haex-hive/schemas/install-journal.v1.schema.json",
  "title": "haex-hive Install Journal Entry v1",
  "description": "Schema for one line of install.journal (JSONL). Each line is one write-ahead entry preceding its corresponding filesystem mutation. See Spec 008 FR-002 and research §R7.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry_id",
    "wrote_at_ns",
    "entry_type",
    "tail_hash"
  ],
  "properties": {
    "entry_id": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonically increasing from 0 within one install. Equals the count of preceding entries in the same journal."
    },
    "wrote_at_ns": {
      "type": "integer",
      "minimum": 0,
      "description": "time.monotonic_ns() value at write. Informational; never used for ordering (entry_id is authoritative)."
    },
    "step_id": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ],
      "description": "Corresponding PlanStep.step_id when the entry is a step boundary; null for lifecycle entries."
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "plan_snapshot_sealed",
        "commit_snapshot_verified",
        "stage_file",
        "delete_orphan",
        "hook_step_started",
        "hook_step_ended",
        "overlay_pointer_swapped",
        "install_lock_sealed",
        "commit_marker_published",
        "cleanup_started",
        "cleanup_completed",
        "install_aborted"
      ]
    },
    "payload": {
      "type": "object",
      "description": "Entry-type-specific payload. `stage_file` and `delete_orphan` payloads MUST include the root-relative path, prior existence, prior digest, and a transaction-relative pre-image reference before the mutation. Cleanup payloads identify only transaction-owned staging or rollback paths. Consumers MUST reject unknown keys per entry_type in Spec 008; forward-compat with new entry types is handled by a version bump on this schema."
    },
    "tail_hash": {
      "type": "string",
      "pattern": "^sha256-[A-Za-z0-9_-]{43}$",
      "description": "SHA-256, emitted as sha256-<base64url-nopad>, over the UTF-8 bytes of canonical JSON for this entry with tail_hash excluded, followed by one LF byte and the previous tail hash as ASCII. Canonical JSON uses RFC 8785-compatible deterministic key ordering, no insignificant whitespace, and UTF-8; the first entry uses an empty previous-hash string, so its preimage ends with LF. The serialized JSONL line itself is terminated by a separate LF and never participates in the preimage."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "entry_type": { "enum": ["stage_file", "delete_orphan"] }
        }
      },
      "then": {
        "required": ["payload"],
        "properties": {
          "payload": { "$ref": "#/$defs/mutationPayload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "entry_type": { "enum": ["cleanup_started", "cleanup_completed"] }
        }
      },
      "then": {
        "required": ["payload"],
        "properties": {
          "payload": { "$ref": "#/$defs/cleanupPayload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "entry_type": {
            "enum": [
              "plan_snapshot_sealed",
              "commit_snapshot_verified",
              "hook_step_started",
              "hook_step_ended",
              "overlay_pointer_swapped",
              "install_lock_sealed",
              "commit_marker_published",
              "install_aborted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": { "maxProperties": 0 }
        }
      }
    }
  ],
  "$defs": {
    "rootRelativePath": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)\\.[A-Za-z0-9._-]+/[^\\u0000-\\u001F\\u007F\\\\]+$"
    },
    "transactionRelativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\u0000-\\u001F\\u007F]+$"
    },
    "mutationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "existed", "content_integrity", "pre_image"],
      "properties": {
        "path": { "$ref": "#/$defs/rootRelativePath" },
        "existed": { "type": "boolean" },
        "content_integrity": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256-[A-Za-z0-9_-]{43}$" }
          ]
        },
        "pre_image": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/transactionRelativePath" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "existed": { "const": true } } },
          "then": {
            "properties": {
              "content_integrity": {
                "type": "string",
                "pattern": "^sha256-[A-Za-z0-9_-]{43}$"
              },
              "pre_image": { "$ref": "#/$defs/transactionRelativePath" }
            }
          }
        },
        {
          "if": { "properties": { "existed": { "const": false } } },
          "then": {
            "properties": {
              "content_integrity": { "type": "null" },
              "pre_image": { "type": "null" }
            }
          }
        }
      ]
    },
    "cleanupPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path"],
            "properties": {
              "kind": { "type": "string", "enum": ["staging", "rollback"] },
              "path": { "$ref": "#/$defs/transactionRelativePath" }
            }
          }
        }
      }
    }
  }
}
