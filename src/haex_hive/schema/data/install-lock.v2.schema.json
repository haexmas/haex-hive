{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haexmas/haex-hive/schemas/install-lock.v2.schema.json",
  "title": "haex-hive Install Lockfile v2 (Spec 008, trust-git amendment)",
  "description": "Schema for `.haex-hive/install.lock` as authored by Spec 008 after the 2026-09-01 trust-git amendment. Records the resolved atom set and immutable generation-input identities. Per-file and per-root `content_integrity` fields are retired; deterministic generation from pinned inputs provides byte identity for generated payloads. The constitution-only shape (no atoms, no roots) is what `haex constitution assemble` writes today; the full shape lands with `haex install`.",
  "type": "object",
  "required": ["haex_hive_version", "generated_by"],
  "properties": {
    "haex_hive_version": { "const": "2" },
    "generated_by": {
      "type": "string",
      "pattern": "^haex [0-9]+\\.[0-9]+\\.[0-9]+.*$",
      "description": "e.g. 'haex 2.1.0'."
    },
    "constitution": {
      "$ref": "#/$defs/constitutionBlock",
      "description": "Constitution block. Present when the install includes at least one atom contributing a constitution."
    },
    "atoms": {
      "type": "array",
      "items": { "$ref": "#/$defs/atomInstallRecord" },
      "description": "One entry per adopted atom whose contribution is recorded in this install."
    },
    "generation_inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/generationInputIdentity" },
      "uniqueItems": true,
      "description": "Immutable adapter and tool-configuration identities used to generate this publication; order MUST be `(kind, id)`-sorted."
    },
    "participating_roots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rootName" },
      "uniqueItems": true,
      "description": "MUST match visibility.json.participating_roots byte-identically at publication time."
    },
    "visibility_marker": {
      "$ref": "#/$defs/visibilityMarkerRef",
      "description": "Cross-reference to the .haex-hive/visibility.json marker this lock corresponds to (by generation_id only)."
    }
  },
  "$defs": {
    "rootName": {
      "type": "string",
      "pattern": "^(?!\\.\\.?/$)\\.[A-Za-z0-9._-]+/$",
      "description": "Repo-relative directory with trailing slash, e.g. '.haex-hive/'."
    },
    "constitutionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "assembled_by"],
      "properties": {
        "sources": { "type": "array" },
        "assembled_by": { "type": "object" }
      }
    },
    "atomInstallRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "revision", "contributed_paths"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
          "description": "Reverse-DNS atom-id per Spec 007."
        },
        "source": {
          "type": "string",
          "format": "uri",
          "description": "Publisher repo URL."
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full 40-char SHA per Principle IV — the byte-identity anchor under the trust-git amendment."
        },
        "contributed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)\\.[A-Za-z0-9._-]+/[^\\u0000-\\u001F\\u007F\\\\]+$"
          },
          "description": "Repo-relative POSIX paths this atom contributed under participating roots."
        }
      }
    },
    "generationInputIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "serialization"],
      "properties": {
        "kind": { "type": "string", "enum": ["adapter", "tool-config"] },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "revision": {
          "oneOf": [
            { "type": "string", "pattern": "^git:[0-9a-f]{40}$" },
            { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          ]
        },
        "serialization": { "$ref": "#/$defs/serializationProfile" }
      }
    },
    "serializationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "encoding", "newline", "key_order", "indent", "ensure_ascii"],
      "properties": {
        "format": { "type": "string", "enum": ["json", "text", "toml"] },
        "encoding": { "const": "UTF-8" },
        "newline": { "const": "LF" },
        "key_order": { "type": "string", "enum": ["lexicographic-utf8", "not-applicable"] },
        "indent": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "ensure_ascii": { "type": "boolean" }
      }
    },
    "visibilityMarkerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_id"],
      "properties": {
        "generation_id": {
          "type": "string",
          "pattern": "^g_[0-9]{8}T[0-9]{6}Z_[0-9a-f]{4}$"
        }
      }
    }
  }
}
