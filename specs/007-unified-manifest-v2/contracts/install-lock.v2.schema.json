{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haexmas/haex-hive/schemas/install-lock.v2.schema.json",
  "title": "haex-hive install.lock v2 (Spec-007 subset)",
  "description": "Schema for .haex-hive/install.lock as authored by Spec 007. Spec 008 will extend this with atoms[] and generated_content_integrity fields. Spec 007's write MUST preserve unknown top-level fields for forward compatibility (FR-030 forward-compat clause). This schema does NOT set additionalProperties: false at the root, because Spec 008 will add root fields.",
  "type": "object",
  "required": ["haex_hive_version", "generated_by"],
  "properties": {
    "haex_hive_version": { "const": "2" },
    "generated_by": {
      "type": "string",
      "pattern": "^haex [0-9]+\\.[0-9]+\\.[0-9]+.*$",
      "description": "Format: 'haex <version>'. e.g., 'haex 2.0.0'."
    },
    "constitution": { "$ref": "#/$defs/constitutionLockSection" }
  },
  "$defs": {
    "atomId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$",
      "minLength": 3,
      "maxLength": 253
    },
    "canonicalSourceUrl": {
      "type": "string",
      "pattern": "^(https|ssh|git):\\/\\/[^@]+$"
    },
    "fullSha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256Base64": {
      "type": "string",
      "pattern": "^sha256-[A-Za-z0-9+/]{43}=$",
      "description": "SHA-256 digest in Subresource Integrity format: 'sha256-' + standard base64 (with padding). See R11."
    },
    "constitutionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/atomId" },
        "revision": { "$ref": "#/$defs/fullSha40" },
        "source": { "$ref": "#/$defs/canonicalSourceUrl" }
      }
    },
    "constitutionLockSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "content_integrity"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/constitutionSource" },
          "description": "Contributing atoms, sorted alphabetically by id."
        },
        "content_integrity": {
          "$ref": "#/$defs/sha256Base64",
          "description": "SHA-256 of .haex-hive/constitution.md bytes."
        }
      }
    }
  }
}
